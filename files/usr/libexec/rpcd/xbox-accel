#!/bin/sh
# rpcd 插件：只提供固定的几个操作，不执行调用方传入的任何命令

. /usr/share/libubox/jshn.sh
PROG=/usr/bin/xbox-accel

reply() {
	json_init
	json_add_boolean ok "$1"
	json_add_string message "$2"
	case "${command:-}" in test|test_cn|test_com|test_store|test_ps|test_xbox_old|test_switch|adopt_cn|adopt_com|adopt_store|adopt_ps|adopt_xbox_old|adopt_switch|apply|restart|verify|export)
		json_add_boolean accepted "$1"
		json_add_string task_id "$(printf '%s' "$2" | sed -n 's/.*任务已受理：\([0-9T-]*\).*/\1/p')"
		;;
	esac
	json_dump
}

case "$1" in
list)
	echo '{"status":{},"environment":{},"records":{},"action":{"command":"str","groups":"str","result_id":"str"}}'
	;;
call)
	case "$2" in
	status) exec "$PROG" json_status ;;
	environment) exec "$PROG" json_preflight ;;
	records) exec "$PROG" json_records ;;
	action)
		read -r request
		jshn -r "$request" >/dev/null 2>&1 && json_load "$request" 2>/dev/null || { reply 0 "请求格式错误"; exit 0; }
		json_get_var command command
		json_get_var groups groups
		json_get_var result_id result_id
		case "$command" in
		test) out=$("$PROG" start_measure "${groups:-all}" manual_ui 2>&1) && ok=1 || ok=0 ;;
		test_cn|test_com|test_store|test_ps|test_xbox_old|test_switch)
			out=$("$PROG" start_measure "${command#test_}" manual_ui 2>&1) && ok=1 || ok=0 ;;
		adopt_cn|adopt_com|adopt_store|adopt_ps|adopt_xbox_old|adopt_switch)
			out=$("$PROG" start_adopt "${command#adopt_}" "$result_id" manual_ui 2>&1) && ok=1 || ok=0 ;;
		cancel) out=$("$PROG" cancel 2>&1) && ok=1 || ok=0 ;;
		clear_log) out=$("$PROG" clear_log 2>&1) && ok=1 || ok=0 ;;
		reset) out=$("$PROG" reset 2>&1) && ok=1 || ok=0 ;;
		apply) out=$("$PROG" start_apply manual_ui 2>&1) && ok=1 || ok=0 ;;
		restart) out=$("$PROG" start_restart manual_ui 2>&1) && ok=1 || ok=0 ;;
		verify) out=$("$PROG" start_verify manual_ui 2>&1) && ok=1 || ok=0 ;;
		export) out=$("$PROG" start_report manual_ui 2>&1) && ok=1 || ok=0 ;;
		*)
			reply 0 "不支持的操作"
			exit 0
			;;
		esac
		reply "$ok" "$out"
		;;
	esac
	;;
esac
