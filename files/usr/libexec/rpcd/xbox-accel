#!/bin/sh
# rpcd 插件：只提供固定的几个操作，不执行调用方传入的任何命令

. /usr/share/libubox/jshn.sh
PROG=/usr/bin/xbox-accel

reply() {
	json_init
	json_add_boolean ok "$1"
	json_add_string message "$2"
	json_dump
}

case "$1" in
list)
	echo '{"status":{},"environment":{},"action":{"command":"str"}}'
	;;
call)
	case "$2" in
	status) exec "$PROG" json_status ;;
	environment) exec "$PROG" json_env ;;
	action)
		read -r request
		json_load "$request" 2>/dev/null || { reply 0 "请求格式错误"; exit 0; }
		json_get_var command command
		case "$command" in
		test) out=$("$PROG" start_test all 2>&1) && ok=1 || ok=0 ;;
		test_cn) out=$("$PROG" start_test cn 2>&1) && ok=1 || ok=0 ;;
		test_com) out=$("$PROG" start_test com 2>&1) && ok=1 || ok=0 ;;
		cancel) out=$("$PROG" cancel 2>&1) && ok=1 || ok=0 ;;
		clear_log) out=$("$PROG" clear_log 2>&1) && ok=1 || ok=0 ;;
		reset) out=$("$PROG" reset 2>&1) && ok=1 || ok=0 ;;
		apply) out=$(/etc/init.d/xbox-accel reload 2>&1) && ok=1 || ok=0 ;;
		*)
			reply 0 "不支持的操作"
			exit 0
			;;
		esac
		reply "$ok" "$out"
		;;
	esac
	;;
esac
