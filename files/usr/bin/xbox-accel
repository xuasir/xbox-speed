#!/bin/sh
# xbox-accel: 游戏平台下载 CDN 优选 + Xbox com→cn 重定向（OpenWrt）
# 结构：主 dnsmasq 只写固定规则，把 Xbox 下载域名交给本插件的解析实例；
#       换节点、切模式只改解析实例的配置，不动主 dnsmasq。

VERSION=0.3.0
NAME=xbox-accel
STATE_DIR=/etc/xbox-accel
RUN_DIR=/var/run/xbox-accel
TMP_DIR=/tmp/xbox-accel
RESOLVER_CONF=/var/etc/xbox-accel/dnsmasq.conf
SHARE_DIR=/usr/share/xbox-accel
INIT=/etc/init.d/xbox-accel
CGI_URL=/cgi-bin/xbox-accel-redirect
REDIRECT_ROOT=/var/etc/xbox-accel/redirect
REDIRECT_CONF=/var/etc/xbox-accel/redirect.conf
REDIRECT_HTTPD_CONF=/var/etc/xbox-accel/redirect.httpd.conf
CRON_FILE=/etc/crontabs/root
CRON_TAG='# xbox-accel'

# 国内下载域名
CN_DOMAINS="assets1.xboxlive.cn assets2.xboxlive.cn d1.xboxlive.cn d2.xboxlive.cn"
# 国际下载域名
COM_DOMAINS="assets1.xboxlive.com assets2.xboxlive.com d1.xboxlive.com d2.xboxlive.com xvcf1.xboxlive.com xvcf2.xboxlive.com"
# 国际老游戏下载域名：只在重定向模式下接管（跳到 dlassets.xboxlive.cn）
COM_DL_DOMAINS="dlassets.xboxlive.com dlassets2.xboxlive.com"
# 主机通过 SRV 记录拿到的备用 CDN 主机名
CDN_HOSTS="5.xb.delivery.microsoft.com assets1.xboxlive.com.edgesuite.net cl-glcb907925.gcdn.co fg.microsoft.map.fastly.net"
# 返回上述 SRV 记录的名字
SRV_NAMES="assets-srvs.xboxlive.com assets-srvs-net.trafficmanager.net assets-srvs-apac.delivery.microsoft.com"

DEF_URL_CN="http://assets1.xboxlive.cn/Z/routing/extraextralarge.txt"
DEF_URL_COM="http://assets1.xboxlive.com/Z/routing/extraextralarge.txt"

LOG_FILE=$TMP_DIR/activity.log
LOG_ACTIVE=0 # 1：同时写入任务日志（LuCI 页面显示的就是它）
QUIET=0      # 1：后台任务，标准输出和错误输出已经重定向到任务日志

stamp() { date '+%m-%d %H:%M:%S'; }

say() {
	if [ "$QUIET" = 1 ]; then
		printf '%s %s\n' "$(stamp)" "$*"
	else
		echo "$*"
		[ "$LOG_ACTIVE" = 1 ] && printf '%s %s\n' "$(stamp)" "$*" >>"$LOG_FILE"
	fi
	return 0
}

note() {
	say "$*"
	system_log "$*"
	return 0
}

die() {
	if [ -n "${TASK_ID:-}" ]; then
		TASK_STATUS=failed; TASK_MESSAGE="$*"
		[ "$TASK_CODE" = RUNNING ] && TASK_CODE=FATAL_ERROR
	fi
	if [ "$QUIET" = 1 ]; then
		printf '%s 错误：%s\n' "$(stamp)" "$*"
	else
		echo "错误：$*" >&2
		[ "$LOG_ACTIVE" = 1 ] && printf '%s 错误：%s\n' "$(stamp)" "$*" >>"$LOG_FILE"
	fi
	exit 1
}

# 任务日志放在内存文件系统里，只保留最近 500 行
rotate_log() {
	[ -f "$LOG_FILE" ] || return 0
	[ "$(wc -l <"$LOG_FILE")" -gt 500 ] || return 0
	tail -n 500 "$LOG_FILE" >"$LOG_FILE.new" && cat "$LOG_FILE.new" >"$LOG_FILE"
	rm -f "$LOG_FILE.new"
}

# 在服务子进程中清理全部继承描述符，调用方继续持有自己的锁。
close_service_fds() {
	local descriptor directory=/proc/self/fd
	[ -d "$directory" ] || directory=/dev/fd
	for descriptor in "$directory"/*; do
		descriptor=${descriptor##*/}
		case "$descriptor" in ''|*[!0-9]*|0|1|2) continue ;; esac
		eval "exec $descriptor>&-"
	done
}

# 系统日志写入最多等待两秒；完整任务日志先保存在插件自己的目录。
system_log() {
	local writer watchdog
	(
		close_service_fds
		exec logger -t "$NAME" -- "$*"
	) >/dev/null 2>&1 &
	writer=$!
	(
		close_service_fds
		local timer
		sleep 2 & timer=$!
		trap 'kill "$timer" 2>/dev/null; exit 0' INT TERM
		wait "$timer"
		kill -KILL "$writer" 2>/dev/null
	) >/dev/null 2>&1 &
	watchdog=$!
	wait "$writer" 2>/dev/null || true
	kill -TERM "$watchdog" 2>/dev/null
	wait "$watchdog" 2>/dev/null
	return 0
}

svc() {
	(
		close_service_fds
		"$@" >/dev/null 2>&1
	)
}

cfg() {
	local v
	v=$(uci -q get "$NAME.main.$1") || v=
	if [ -n "$v" ]; then echo "$v"; else echo "$2"; fi
}

# 每个进程只读取一次采集模式，省去逐行 UCI 查询。
LOG_MODE=$(cfg log_mode concise)
case "$LOG_MODE" in concise|detail) ;; *) LOG_MODE=concise ;; esac

# 未设置新字段的旧配置继续使用原 cron；新计划统一转换为 cron。
schedule_cron() {
	local kind time day
	kind=$(cfg schedule_type legacy)
	[ "$kind" = off ] && return 0
	[ "$kind" = legacy ] && { cfg cron '15 5 * * *'; return; }
	case "$kind" in daily|weekly|monthly) ;; *) return 1 ;; esac
	time=$(cfg schedule_time '05:15')
	printf '%s\n' "$time" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$' || return 1
	case "$kind" in
	daily) day='* * *' ;;
	weekly)
		day=$(cfg schedule_weekday 0)
		case "$day" in [0-6]) ;; *) return 1 ;; esac
		day="* * $day" ;;
	monthly)
		day=$(cfg schedule_monthday 1)
		printf '%s\n' "$day" | grep -qE '^([1-9]|[12][0-9]|3[01])$' || return 1
		day="$day * *" ;;
	esac
	printf '%s\n' "$time" | awk -F: -v day="$day" '{printf "%d %d %s\n",$2,$1,day}'
}

schedule_label() {
	local plan
	[ "$(cfg schedule_type legacy)" = off ] && { echo '仅手动测速'; return; }
	plan=$(schedule_cron) || { echo '测速计划设置无效'; return; }
	case "$plan" in
	'*/30 * * * *') echo '每 30 分钟（每小时 00、30 分）' ;;
	'0 * * * *') echo '每小时整点' ;;
	'0 */3 * * *') echo '每 3 小时（00、03、06、09、12、15、18、21 点）' ;;
	'0 */6 * * *') echo '每 6 小时（00、06、12、18 点）' ;;
	'0 */12 * * *') echo '每 12 小时（00、12 点）' ;;
	'0 3 * * 0') echo '每周日 03:00' ;;
	*) printf '%s\n' "$plan" | awk 'BEGIN{split("日 一 二 三 四 五 六",days," ")} {
	 if(NF==5 && $1~/^[0-9]+$/ && $2~/^[0-9]+$/ && $4=="*") {
	  if($3=="*" && $5=="*") {printf "每天 %02d:%02d\n",$2,$1; exit}
	  if($3=="*" && $5~/^[0-7]$/) {printf "每周%s %02d:%02d\n",days[($5%7)+1],$2,$1; exit}
	  if($3~/^[0-9]+$/ && $3>=1 && $3<=31 && $5=="*") {printf "每月 %d 号 %02d:%02d%s\n",$3,$2,$1,($3>28?"（无该日期的月份跳过）":""); exit}
	 } print "保留的自定义计划"}' ;;
	esac
}

health_label() {
	cfg health_interval 10 | awk '{if($0!~/^[0-9]+$/){print "设置无效，请重新选择"; exit} v=$0+0; if(v==0) print "关闭"; else if(v>0 && v<60 && 60%v==0) printf "每 %d 分钟\n",v; else if(v>0 && v<60) {printf "每小时 "; for(i=0;i<60;i+=v) printf "%s%02d", i?"、":"", i; print " 分"} else print "设置无效，请重新选择"}'
}

DNS_INSTANCE=$(cfg dnsmasq_instance '@dnsmasq[0]')
# 支持选择主实例；如果启用期间切换实例，先要求停用旧实例避免遗留规则。

cfg_bool() {
	case "$(cfg "$1" "$2")" in
	1 | on | true | yes | enabled) return 0 ;;
	*) return 1 ;;
	esac
}

# 从标准输入提取合法 IPv4，每行一个
ipv4s() {
	grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | awk -F. '$1<=255 && $2<=255 && $3<=255 && $4<=255'
}

# 只保留公网地址：CDN 节点不可能是内网、环回或保留地址
public_only() {
	awk -F. '
		$1==0 || $1==10 || $1==127 || $1>=224 { next }
		$1==100 && $2>=64 && $2<=127 { next }
		$1==169 && $2==254 { next }
		$1==172 && $2>=16 && $2<=31 { next }
		$1==192 && $2==168 { next }
		$1==198 && ($2==18 || $2==19) { next }
		{ print }'
}

uniq_keep_order() { awk '!seen[$0]++'; }

to_int() {
	local v=${1%%.*}
	case "$v" in '' | *[!0-9]*) echo 0 ;; *) echo "$v" ;; esac
}

fmt_speed() {
	awk -v b="$1" 'BEGIN { printf "%.2f MB/s（%.0f Mbps）", b/1000000, b*8/1000000 }'
}

url_scheme() { printf '%s\n' "${1%%://*}"; }
url_host() { local u=${1#*://}; printf '%s\n' "${u%%/*}"; }
url_path() { local u=${1#*://}; printf '/%s\n' "${u#*/}"; }

group_url() {
	case "$1" in
	cn) cfg test_url_cn "$DEF_URL_CN" ;;
	com) cfg test_url_com "$DEF_URL_COM" ;;
	*) platform_url "$1" ;;
	esac
}

group_offset() { to_int "$(cfg "test_offset_$1" 0)"; }

best_ip() {
	local ip
	ip=$(cat "$STATE_DIR/best_$1" 2>/dev/null | ipv4s | head -n 1)
	[ -n "$ip" ] && echo "$ip"
}

best_domains() { cat "$STATE_DIR/domains_$1" 2>/dev/null; }

lan_ip() {
	local ip
	ip=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	[ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr | awk '{print $1}')
	[ -n "$ip" ] || ip=$(ip -4 addr show dev "$(redirect_device)" 2>/dev/null | awk '/inet /{print $2; exit}')
	echo "${ip%%/*}" | ipv4s | head -n 1
}

port_available() {
	local hex inode fd ours pid listeners
	hex=$(printf '%04X' "$1")
	listeners=$(awk -v port=":$hex" '$2 ~ (port "$" ) && ($4=="0A" || FILENAME ~ /udp/) {print $10}' /proc/net/tcp /proc/net/tcp6 /proc/net/udp /proc/net/udp6 2>/dev/null)
	[ -n "$listeners" ] || return 0
	pid=$(cat "$RUN_DIR/dnsmasq.pid" 2>/dev/null)
	process_matches "$pid" "$RESOLVER_CONF" || return 1
	for inode in $listeners; do
		ours=0
		for fd in /proc/"$pid"/fd/*; do
			[ "$(readlink "$fd" 2>/dev/null)" = "socket:[$inode]" ] && ours=1 && break
		done
		[ "$ours" = 1 ] || return 1
	done
	return 0
}

# 修改系统配置前拒绝无效参数，尤其防止解析回环和 cron 注入。
validate_config() {
	local port s schedule url host g spec key min max v

	case "$(cfg log_mode concise)" in concise|detail) ;; *) die "日志模式请选择 concise 或 detail" ;; esac
	for spec in 'quick_size_mb:1:128:4' 'full_size_mb:1:256:64' 'quick_time:1:30:4' 'full_time:1:60:10' 'top_n:1:10:3' 'max_candidates:1:100:60' 'switch_threshold:0:100:15' 'ttl:5:600:30' 'health_interval:0:59:10'; do
		key=${spec%%:*}; spec=${spec#*:}; min=${spec%%:*}; spec=${spec#*:}; max=${spec%%:*}
		v=$(cfg "$key" "${spec#*:}")
		case "$v" in ''|*[!0-9]*) die "$key 必须是整数" ;; esac
		[ "$v" -ge "$min" ] && [ "$v" -le "$max" ] || die "$key 超出范围 $min..$max"
	done
	printf '%s' "$DNS_INSTANCE" | grep -qE '^(@dnsmasq\[[0-9]+\]|[A-Za-z0-9_]+)$' || die "主实例名称无效"
	[ "$(uci -q get "dhcp.$DNS_INSTANCE")" = dnsmasq ] || die "所选主 dnsmasq 实例不存在"
	command -v flock >/dev/null || die "缺少 flock"
	port=$(cfg resolver_port 5335)
	case "$port" in ''|*[!0-9]*) die "resolver_port 必须是整数" ;; esac
	[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || die "resolver_port 必须在 1024..65535"
	port_available "$port" || die "独立解析端口 $port 被其他服务占用"
	for s in $(cfg fallback_dns "223.5.5.5 119.29.29.29"); do
		[ "$(printf '%s' "$s" | ipv4s | public_only)" = "$s" ] || die "fallback_dns 只允许公网 IPv4，避免回环"
	done
	schedule=$(schedule_cron) || die "定时测速计划无效：检查频率、HH:MM、星期几或每月日期"
	if [ "$(cfg schedule_type legacy)" != off ]; then
	[ "$(printf '%s' "$schedule" | tr -d '0-9*/ ,\055')" = "" ] || die "cron 含非法字符"
	set -f
	set -- $schedule
	set +f
	[ "$#" = 5 ] || die "cron 必须有五个字段"
	printf '%s\n' "$schedule" | awk '
	function valid(f,lo,hi, n,a,i,k,b,c,step,x,y) {
	 n=split(f,a,","); for(i=1;i<=n;i++) {
	  k=split(a[i],b,"/"); if(k>2||k<1) return 0;
	  if(k==2&&(b[2]!~/^[0-9]+$/||b[2]<1||b[2]>hi+1)) return 0;
	  if(b[1]=="*") continue;
	  k=split(b[1],c,"-"); if(k>2||k<1) return 0;
	  if(c[1]!~/^[0-9]+$/||c[1]<lo||c[1]>hi) return 0;
	  if(k==2&&(c[2]!~/^[0-9]+$/||c[2]<lo||c[2]>hi||c[2]<c[1])) return 0;
	 } return 1;
	}
	{exit !(NF==5&&valid($1,0,59)&&valid($2,0,23)&&valid($3,1,31)&&valid($4,1,12)&&valid($5,0,7))}' || die "cron 字段值或范围无效"
	fi
	for g in cn com; do
		url=$(group_url "$g")
		host=$(url_host "$url")
		[ "$(url_scheme "$url")" = http ] && [ "$host" = "assets1.xboxlive.$g" ] && platform_url_valid "$g" "$url" || die "测速 URL 必须使用 http://assets1.xboxlive.$g/ 路径"
	done
	validate_platform_config
	if cfg_bool redirect_cn 0; then
		v=$(redirect_blocker)
		[ -z "$v" ] || die "重定向配置无效：$v"
	fi
	return 0
}

# 国际域名的工作模式：redirect / optimize / off
com_mode() {
	if cfg_bool redirect_cn 0 && [ -z "$(redirect_blocker)" ]; then
		echo redirect
	elif cfg_bool optimize_com 1; then
		echo optimize
	else
		echo off
	fi
}

# ---------- Passwall 直连 ----------

# 把 IP 加入 Passwall 的直连集合；没有 Passwall 时什么都不做
passwall_direct() {
	local ip
	cfg_bool passwall_direct 1 || return 0
	[ $# -gt 0 ] || return 0
	if command -v nft >/dev/null 2>&1 && nft list set inet passwall psw_white >/dev/null 2>&1; then
		for ip in "$@"; do
			# 先删后加可以刷新过期时间；元素不存在时退回到直接添加
			printf 'delete element inet passwall psw_white { %s }\nadd element inet passwall psw_white { %s }\n' "$ip" "$ip" |
				nft -f - 2>/dev/null ||
				nft add element inet passwall psw_white "{ $ip }" 2>/dev/null
		done
	elif command -v ipset >/dev/null 2>&1 && ipset list -n psw_white >/dev/null 2>&1; then
		for ip in "$@"; do
			ipset -! add psw_white "$ip" timeout 0 2>/dev/null || ipset -! add psw_white "$ip" 2>/dev/null
		done
	fi
	return 0
}

# ---------- 候选发现 ----------

isp_dns() {
	local f
	for f in /tmp/resolv.conf.d/resolv.conf.auto /tmp/resolv.conf.auto; do
		[ -f "$f" ] && awk '$1=="nameserver"{print $2}' "$f"
	done | ipv4s | grep -v '^127\.' | uniq_keep_order
}

# 运营商对应的参考网段：用于向 HTTPDNS 询问“该运营商其他地区会分到哪些节点”
ecs_subnets() {
	local isp
	isp=$(cfg isp auto)
	case "$isp" in
	telecom | unicom | mobile)
		[ -f "$SHARE_DIR/ecs.$isp" ] && grep -v '^#' "$SHARE_DIR/ecs.$isp" | awk '{print $1}'
		;;
	esac
	cfg ecs_subnet "" | tr ' ' '\n'
}

discover() {
	local group=$1 hosts servers h resolver subnet index=0 d="$TMP_DIR/discover.$$"
	hosts=$(discovery_hosts "$group")
	rm -rf "$d"; mkdir -p "$d"
	servers=$(cfg probe_dns '223.5.5.5 119.29.29.29 114.114.114.114 180.76.76.76')
	cfg_bool use_isp_dns 1 && servers="$servers $(isp_dns | tr '\n' ' ')"
	for resolver in $(echo "$servers" | tr ' ' '\n' | ipv4s | uniq_keep_order); do
		for h in $hosts; do
			index=$((index+1))
			(
				result=$(nslookup -timeout=3 -retry=1 "$h" "$resolver" 2>&1); rc=$?
				ips=$(printf '%s\n' "$result" | ipv4s | grep -vxF "$resolver" | public_only | uniq_keep_order)
				printf '%s\n' "$ips" >"$d/a$index"
				if [ -n "$ips" ]; then
					log_event_enabled INFO DNS_QUERY_OK && task_event INFO DNS_QUERY_OK "resolver=$resolver host=$h answers=$(echo "$ips" | tr '\n' ',')"
				else
					code=DNS_NO_PUBLIC_ADDRESS
					printf '%s' "$result" | grep -qi 'NXDOMAIN' && code=DNS_NXDOMAIN
					printf '%s' "$result" | grep -qi 'timed out' && code=DNS_QUERY_TIMEOUT
					task_event WARN "$code" "resolver=$resolver host=$h exit=$rc；未获得公网 IPv4，请检查上游、域名和网络"
				fi
			) &
		done
	done
	for subnet in current $(ecs_subnets | ipv4s | uniq_keep_order); do
		for h in $hosts; do
			index=$((index+1))
			(
				url="http://119.29.29.29/d?dn=$h"
				[ "$subnet" = current ] || url="$url&ip=$subnet"
				result=$(curl -sS --noproxy '*' -m 6 "$url" 2>"$d/error$index"); rc=$?
				ips=""
				if [ "$rc" = 0 ] && ! printf '%s' "$result" | grep -q '[^0-9.;,[:space:]]'; then
					ips=$(printf '%s' "$result" | tr ';,' '\n\n' | ipv4s | public_only | uniq_keep_order)
				fi
				printf '%s\n' "$ips" >"$d/b$index"
				if [ -n "$ips" ]; then
					log_event_enabled INFO HTTPDNS_QUERY_OK && task_event INFO HTTPDNS_QUERY_OK "host=$h ecs=$subnet answers=$(echo "$ips" | tr '\n' ',')"
				else
					code=HTTPDNS_INVALID_RESPONSE
					[ "$rc" = 0 ] || code=$(probe_classify "$rc" 000 0 1)
					task_event WARN "$code" "HTTPDNS host=$h ecs=$subnet curl_exit=$rc error=$(head -c 250 "$d/error$index" 2>/dev/null)；请检查请求错误与地址列表"
				fi
			) &
		done
	done
	wait
	cat "$d"/a* "$d"/b* 2>/dev/null
	rm -rf "$d"
}

candidates() {
	local group=$1 max
	max=$(to_int "$(cfg max_candidates 60)")
	[ "$max" -gt 0 ] || max=60
	{
		best_ip "$group"
		cfg "extra_ips_$group" '' | tr ' ' '\n' | ipv4s
		discover "$group"
		[ -f "$STATE_DIR/candidates_$group" ] && ipv4s <"$STATE_DIR/candidates_$group"
		cfg_bool use_seeds 1 && [ -f "$SHARE_DIR/seeds.$group" ] && ipv4s <"$SHARE_DIR/seeds.$group"
	} | public_only | uniq_keep_order | head -n "$max"
}

# ---------- 测速 ----------

# probe → HTTP bytes speed curl_exit connect_s total_s remote_ip; stderr stays available to callers.
probe() {
	local ip=$1 host=$2 path=$3 offset=$4 limit=$5 timeout_s=$6 scheme=${7:-http} agent=${8:-} port=80 end stats rc
	case "$scheme" in http) ;; https) port=443 ;; *) printf '000 0 0 3 0 0 -\n'; return ;; esac
	end=$((offset + limit - 1))
	mkdir -p "$TMP_DIR"
	set -- -sS --globoff -o /dev/null --noproxy '*' --connect-timeout 3 -m "$timeout_s" --max-filesize "$limit" -r "$offset-$end" \
		--resolve "$host:$port:$ip" -w '%{http_code} %{size_download} %{speed_download} %{time_connect} %{time_total} %{remote_ip}'
	[ -z "$agent" ] || set -- "$@" -A "$agent"
	stats=$(curl "$@" "$scheme://$host$path" 2>"$TMP_DIR/probe-error-$$.txt")
	rc=$?
	set -- $stats
	printf '%s %s %s %s %s %s %s\n' "${1:-000}" "${2:-0}" "${3:-0}" "$rc" "${4:-0}" "${5:-0}" "${6:--}"
}

# alive IP HOST PATH OFFSET：取 1KB 判断节点是否正常提供该文件
alive() {
	local ip=$1 host=$2 result code message
	result=$(probe "$1" "$2" "$3" "$4" 1024 6 "${5:-http}" "${6:-}")
	set -- $result
	code=$(probe_classify "${4:-0}" "${1:-000}" "$(to_int "$2")" 1024)
	case "$code" in
	OK|TIME_LIMIT_WITH_DATA) task_event DEBUG "$code" "资源验证 host=$host ip=$ip http=$1 bytes=$2 curl_exit=$4"; return 0 ;;
	*) message=$(head -c 250 "$TMP_DIR/probe-error-$$.txt" 2>/dev/null)
		task_event WARN "$code" "资源验证 host=$host ip=$ip http=$1 bytes=$2 curl_exit=$4 connect_s=${5:-0} total_s=${6:-0} error=$message；$(probe_advice "$code")"; return 1 ;;
	esac
}

# 测一批 IP：stage_run 输出文件 最小有效字节 字节数 超时 HOST PATH OFFSET IP...
stage_run() {
	local out=$1 minb=$2 bytes=$3 tmo=$4 host=$5 path=$6 off=$7 ip r code got speed rc classification message failure_codes="" failure_counts log_failure
	shift 7
	STAGE_VALID=0; STAGE_TOTAL=0; STAGE_LAST_CODE=NONE
	TASK_PROGRESS_TOTAL=$#; TASK_PROGRESS_DONE=0; TASK_PROGRESS_VALID=0
	: >"$out"
	for ip in "$@"; do
		STAGE_TOTAL=$((STAGE_TOTAL+1))
		r=$(probe "$ip" "$host" "$path" "$off" "$bytes" "$tmo" "${PROBE_SCHEME:-http}" "${PROBE_UA:-}")
		set -- $r
		code=${1:-000}; got=$(to_int "$2"); speed=$(to_int "$3"); rc=${4:-0}
		classification=$(probe_classify "$rc" "$code" "$got" "$minb")
		case "$classification" in OK|TIME_LIMIT_WITH_DATA) [ "$speed" -gt 0 ] || classification=INVALID_SPEED ;; esac
		case "$classification" in
		OK|TIME_LIMIT_WITH_DATA)
			STAGE_VALID=$((STAGE_VALID+1))
			echo "$speed $ip" >>"$out"
			log_event_enabled INFO "$classification" && task_event INFO "$classification" "sample=$STAGE_TOTAL ip=$ip host=$host http=$code bytes=$got curl_exit=$rc connect_s=${5:-0} total_s=${6:-0} remote_ip=${7:--} speed=$(fmt_speed "$speed")"
			;;
		*)
			STAGE_LAST_CODE=$classification
			# 简洁模式保留每类失败的首个完整样本，并在阶段结束汇总次数。
			case " $failure_codes " in *" $classification "*) log_failure=0 ;; *) log_failure=1 ;; esac
			if [ "$LOG_MODE" = detail ] || [ "$log_failure" = 1 ]; then
				message=$(head -c 250 "$TMP_DIR/probe-error-$$.txt" 2>/dev/null)
				task_event WARN "$classification" "sample=$STAGE_TOTAL ip=$ip host=$host http=$code bytes=$got curl_exit=$rc connect_s=${5:-0} total_s=${6:-0} error=$message；$(probe_advice "$classification")"
			fi
			failure_codes="$failure_codes $classification"
			;;
		esac
		TASK_PROGRESS_DONE=$STAGE_TOTAL; TASK_PROGRESS_VALID=$STAGE_VALID
		task_snapshot 0
	done
	if [ -n "$failure_codes" ] && [ "$LOG_MODE" = concise ]; then
		failure_counts=$(printf '%s\n' "$failure_codes" | awk '{for(i=1;i<=NF;i++){if(!count[$i]++) order[++n]=$i}} END{for(i=1;i<=n;i++) printf "%s%s=%d",(i>1?" ":""),order[i],count[order[i]]}')
		task_event WARN STAGE_FAILURE_SUMMARY "$failure_counts"
	fi
	task_event INFO STAGE_SUMMARY "samples=$STAGE_TOTAL valid=$STAGE_VALID failed=$((STAGE_TOTAL-STAGE_VALID))"
}

verify_domains() {
	local group=$1 ip=$2 primary url off d list ok="" defaults=""
	primary=$(group_url "$group")
	off=$(group_offset "$group")
	list=$(configured_domains "$group")
	for d in $list; do
		if ! url=$(domain_url "$group" "$d" "$primary"); then
			if [ "$group" = switch ]; then
				case " $SWITCH_GAME_DOMAINS " in *" $d "*) defaults="$defaults $d" ;; esac
			fi
			continue
		fi
		off=$(domain_offset "$group" "$d")
		alive_resource "$ip" "$url" "$off" "$group" && ok="$ok $d"
	done
	if [ "$group" = switch ]; then
		case " $ok " in *" $(url_host "$primary") "*) ok="$ok $defaults" ;; esac
	fi
	echo $ok
}

test_group() {
	local group=$1 url host path off cands count=0 qb qt fb ft topn thr
	local q="$TMP_DIR/quick_$group" f="$TMP_DIR/full_$group"
	local tops cur best best_ip_ best_speed cur_speed chosen chosen_speed doms d resource missing=""
	local PROBE_SCHEME PROBE_UA
	TEST_GROUP_PARTIAL=0
	group_report "$group" running RESOURCE_PREPARING '正在准备测速资源'
	task_stage "resource_$group"
	if ! prepare_group_resource "$group"; then
		group_report "$group" failed "$GROUP_RESOURCE_CODE" "$GROUP_RESOURCE_MESSAGE"
		task_event ERROR "$GROUP_RESOURCE_CODE" "group=$group $GROUP_RESOURCE_MESSAGE"
		return 1
	fi
	url=$(group_url "$group"); host=$(url_host "$url"); path=$(url_path "$url"); off=$(group_offset "$group")
	PROBE_SCHEME=$(url_scheme "$url"); PROBE_UA=$(group_user_agent "$group")
	qb=$(($(to_int "$(cfg quick_size_mb 4)") * 1048576)); qt=$(to_int "$(cfg quick_time 4)")
	fb=$(($(to_int "$(cfg full_size_mb 64)") * 1048576)); ft=$(to_int "$(cfg full_time 10)")
	topn=$(to_int "$(cfg top_n 3)"); thr=$(to_int "$(cfg switch_threshold 15)")
	group_report "$group" running DISCOVERING '正在发现候选节点'
	task_stage "discover_$group"
	say "[$group] 测速文件：$(safe_text "$url")"
	cands=$(candidates "$group"); count=$(echo "$cands" | grep -c .)
	if [ "$count" -eq 0 ]; then
		group_report "$group" failed NO_CANDIDATES '没有候选节点；检查 DNS/HTTPDNS 查询日志，旧配置未替换'
		task_event ERROR NO_CANDIDATES "group=$group"
		return 1
	fi
	[ "${TEST_MODE:-apply}" = measure ] || passwall_direct $cands
	task_stage "quick_$group"
	say "[$group] 初筛 $count 个候选（每个最多 $(cfg quick_size_mb 4) MB / ${qt} 秒）"
	stage_run "$q" 131072 "$qb" "$qt" "$host" "$path" "$off" $cands
	if [ ! -s "$q" ]; then
		group_report "$group" failed QUICK_TEST_FAILED "初筛没有有效样本；最后原因=$STAGE_LAST_CODE；旧配置保留" "" 0 "$count" "$STAGE_VALID"
		return 1
	fi
	cur=$(best_ip "$group")
	tops=$(sort -rn "$q" | head -n "$topn" | awk '{print $2}')
	if [ -n "$cur" ] && grep -q " $cur\$" "$q" && ! echo "$tops" | grep -qxF "$cur"; then tops="$tops $cur"; fi
	task_stage "full_$group"
	say "[$group] 复测（每个最多 $(cfg full_size_mb 64) MB / ${ft} 秒）"
	stage_run "$f" 1048576 "$fb" "$ft" "$host" "$path" "$off" $tops
	if [ ! -s "$f" ]; then
		group_report "$group" failed FULL_TEST_FAILED "复测没有有效样本；最后原因=$STAGE_LAST_CODE；旧配置保留" "" 0 "$count" "$STAGE_VALID"
		return 1
	fi
	best=$(sort -rn "$f" | head -n 1); best_speed=${best%% *}; best_ip_=${best##* }
	chosen=$best_ip_; chosen_speed=$best_speed; cur_speed=""
	[ -n "$cur" ] && cur_speed=$(awk -v ip="$cur" '$2==ip{print $1; exit}' "$f")
	if [ "${TEST_MODE:-apply}" != measure ] && [ -n "$cur_speed" ] && [ "$cur" != "$best_ip_" ] && [ $((best_speed * 100)) -le $((cur_speed * (100 + thr))) ]; then
		chosen=$cur; chosen_speed=$cur_speed
		say "[$group] 最快节点 $best_ip_ 未超过当前节点 ${thr}%，保持 $cur"
	fi
	task_stage "domains_$group"
	doms=$(verify_domains "$group" "$chosen")
	if ! printf '%s\n' $doms | grep -qxF "$host"; then
		group_report "$group" failed PRIMARY_DOMAIN_FAILED '选中节点未通过主下载域名资源校验；旧配置保留' "" 0 "$count" "$STAGE_VALID"
		return 1
	fi
	if [ "${TEST_MODE:-apply}" != measure ] && ! commit_group_result "$group" "$chosen" "$doms"; then
		group_report "$group" failed STATE_COMMIT_FAILED '节点状态提交失败，已恢复原分组结果；检查存储空间与权限' "" 0 "$count" "$STAGE_VALID"
		return 1
	fi
	if [ "${TEST_MODE:-apply}" != measure ]; then
		printf '%s %s %s\n' "$chosen" "$chosen_speed" "$(date +%s)" >"$TMP_DIR/last_$group"
	fi
	for d in $(configured_domains "$group"); do
		resource=$(domain_url "$group" "$d" "$url") || continue
		printf '%s\n' $doms | grep -qxF "$d" || missing="$missing $d"
	done
	if [ -n "$missing" ]; then
		TEST_GROUP_PARTIAL=1
		group_report "$group" partial PARTIAL_COVERAGE "主资源采样通过；接管域名=$doms；保持默认解析的域名=$missing" "$chosen" "$chosen_speed" "$count" "$STAGE_VALID"
	else
		group_report "$group" success SELECTED "主资源采样通过；已准备接管域名=$doms；尚需应用后验收" "$chosen" "$chosen_speed" "$count" "$STAGE_VALID"
	fi
	if [ "${TEST_MODE:-apply}" = measure ]; then
		if ! save_measurement "$group" "$chosen" "$chosen_speed" "$doms" "$count" "$STAGE_VALID" "$TEST_GROUP_PARTIAL"; then
			group_report "$group" failed MEASUREMENT_SAVE_FAILED '测速结果保存失败，请检查存储空间'
			return 1
		fi
		group_report "$group" "$([ "$TEST_GROUP_PARTIAL" = 1 ] && echo partial || echo success)" MEASUREMENT_READY '测速结果已保存，可在结果中选择采用' "$chosen" "$chosen_speed" "$count" "$STAGE_VALID"
		task_event INFO MEASUREMENT_READY "group=$group measured_ip=$chosen speed=$(fmt_speed "$chosen_speed")"
	else
		task_event INFO NODE_SELECTED "group=$group old_ip=${cur:--} selected_ip=$chosen speed=$(fmt_speed "$chosen_speed") domains=$doms"
	fi
	return 0
}

groups_enabled() {
	local g
	cfg_bool optimize_cn 1 && echo cn
	cfg_bool optimize_com 1 && echo com
	for g in $PLATFORM_GROUPS; do cfg_bool "optimize_$g" 0 && echo "$g"; done
	return 0
}

# ---------- 互斥锁与后台任务 ----------

process_matches() {
	case "$1" in '' | *[!0-9]*) return 1 ;; esac
	[ -r "/proc/$1/cmdline" ] || return 1
	tr '\0' ' ' <"/proc/$1/cmdline" | grep -qF -- "$2"
}

task_running() { process_matches "$(cat "$RUN_DIR/task.pid" 2>/dev/null)" xbox-accel; }

# 测速与健康检查互斥
lock() {
	mkdir -p "$RUN_DIR" "$TMP_DIR"
	exec 8>"$RUN_DIR/task.lock"
	flock -n 8 || die "已有测速或健康检查正在运行"
	echo $$ >"$RUN_DIR/task.pid"
	LOG_ACTIVE=1
	trap 'task_exit_rc=$?; measurement_cleanup || task_exit_rc=1; task_on_exit "$task_exit_rc"; rm -f "$RUN_DIR/task.pid"; rm -rf "$TMP_DIR"/discover.*; rm -f "$TMP_DIR/probe-error-$$.txt"' EXIT
	trap 'TASK_STATUS=cancelled; TASK_CODE=CANCELLED; TASK_MESSAGE=任务被用户或服务停止; exit 130' INT TERM
}

# 对系统配置的改动（主 dnsmasq 规则、uhttpd、cron）串行执行
apply_lock() {
	local n=0
	mkdir -p "$RUN_DIR"
	exec 7>"$RUN_DIR/apply.lock"
	until flock -n 7; do
		n=$((n + 1))
		[ "$n" -le 90 ] || die "等待其他配置操作超时"
		sleep 1
	done
}

# 后台任务交给 procd 运行，不依赖浏览器页面或 SSH 会话
start_task() {
	local kind=${1:-all} trigger=${2:-manual_cli} selection=${3:-} result_id=${4:-}
	case "$kind" in all | cn | com | store | ps | xbox_old | switch | apply | restart | verify | report | measure | adopt) ;; *) die "未知任务：$kind" ;; esac
	case "$kind" in
	measure) measurement_groups "${selection:-all}" >/dev/null || die '请选择有效的测速平台' ;;
	adopt) group_valid "$selection" || die '采用结果的平台无效'; printf '%s\n' "$result_id" | grep -qE '^[0-9]{8}T[0-9]{6}-[0-9]+$' || die '请选择当前测速结果' ;;
	esac
	mkdir -p "$RUN_DIR"
	exec 9>"$RUN_DIR/launch.lock"
	flock -n 9 || die "另一个任务正在启动"
	if task_running || ubus call service list '{"name":"xbox-accel-task"}' 2>/dev/null | grep -q '"running": true'; then
		die "已有任务在运行，请等待完成或先停止"
	fi
	rm -f "$RUN_DIR/task.pid"
	# procd 不会重新启动已经退出、参数又没有变化的实例，先移除旧实例
	ubus call service delete '{"name":"xbox-accel-task"}' >/dev/null 2>&1
	if [ "$kind" = report ]; then
		mkdir -p "$TMP_DIR"
		last_task_document >"$TMP_DIR/export-target-task.json"
	fi
	case "$kind" in all|cn|com|store|ps|xbox_old|switch) task_prepare "" test "$trigger" || true ;; *) task_prepare "" "$kind" "$trigger" || true ;; esac
	[ "$TASK_MEMORY_READY" = 1 ] || die "无法记录任务状态，已取消启动；检查 /tmp 可写性和空间"
	initscript=/usr/bin/xbox-accel
	service_triggers() { :; }
	. /lib/functions/procd.sh
	procd_open_service xbox-accel-task /usr/bin/xbox-accel
	procd_open_instance worker
	procd_set_param command /usr/bin/xbox-accel _worker "$kind" "$trigger" "$TASK_ID" "$selection" "$result_id"
	procd_set_param env PATH="$PATH"
	procd_set_param stderr 1
	procd_close_instance
	if ! procd_close_service; then
		TASK_STATUS=failed; TASK_CODE=START_FAILED; TASK_MESSAGE=procd任务注册失败; TASK_FINISHED=$(date +%s); task_snapshot 1; return 1
	fi
	printf '任务已受理：%s。尚未完成，请等待任务摘要。\n' "$TASK_ID"
}

ppid_of() { sed -n 's/^[0-9]* (.*) [A-Za-z] \([0-9]*\) .*/\1/p' "/proc/$1/stat" 2>/dev/null; }

children_of() {
	local f
	for f in /proc/[0-9]*/stat; do
		sed -n "s/^\([0-9][0-9]*\) (.*) [A-Za-z] $1 .*/\1/p" "$f" 2>/dev/null
	done
}

# 只终止确认属于该任务的进程及其子进程，不按名字批量杀 curl
kill_tree() {
	local c signal=${2:-TERM}
	for c in $(children_of "$1"); do kill_tree "$c" "$signal"; done
	kill -"$signal" "$1" 2>/dev/null
	return 0
}

# 从 rc.common 外层限制整个服务操作，覆盖它在加载阶段获取服务锁的等待。
run_service_action() {
	local action=${1:-help} limit worker watchdog timer marker result
	[ "$#" -eq 0 ] || shift
	case "$action" in
	stop|shutdown|disable) limit=60 ;;
	start|restart|reload|boot) limit=120 ;;
	enable|enabled|running|status|info|help) limit=15 ;;
	*) echo "错误：[SERVICE_ACTION_INVALID] 未知服务操作：$action" >&2; return 1 ;;
	esac
	limit=${XBOX_ACCEL_SERVICE_TIMEOUT:-$limit}
	case "$limit" in ''|*[!0-9]*) return 1 ;; esac
	[ "$limit" -ge 1 ] && [ "$limit" -le 300 ] || return 1
	mkdir -p "$RUN_DIR" || return 1
	marker=$(mktemp "$RUN_DIR/service-timeout.XXXXXX") || return 1
	/bin/sh /etc/rc.common "$INIT" "$action" "$@" &
	worker=$!
	(
		close_service_fds
		sleep "$limit" & timer=$!
		trap 'kill "$timer" 2>/dev/null; exit 0' INT TERM
		wait "$timer"
		printf 'timeout\n' >"$marker"
		echo "错误：[SERVICE_TIMEOUT] $action 超过 ${limit} 秒；正在终止等待的服务操作，清理记录保留" >&2
		kill_tree "$worker"
		sleep 1
		kill_tree "$worker" KILL
	) &
	watchdog=$!
	wait "$worker"; result=$?
	# 超时时由 watchdog 完成整个子树的终止；正常退出时清理计时进程。
	if [ -s "$marker" ]; then
		wait "$watchdog" 2>/dev/null
		result=124
	else
		kill -TERM "$watchdog" 2>/dev/null
		wait "$watchdog" 2>/dev/null
	fi
	rm -f "$marker"
	return "$result"
}

is_ancestor() {
	local p=$$
	while [ -n "$p" ] && [ "$p" -gt 1 ]; do
		[ "$p" = "$1" ] && return 0
		p=$(ppid_of "$p")
	done
	return 1
}

cancel_task() {
	local pid attempt
	pid=$(cat "$RUN_DIR/task.pid" 2>/dev/null)
	# 任务自己触发的重载不能反过来杀掉任务
	[ -n "$pid" ] && is_ancestor "$pid" && return 0
	mkdir -p "$RUN_DIR"
	exec 9>"$RUN_DIR/launch.lock"
	flock -n 9 || { say '任务正在启动，请稍后取消'; return 1; }
	if process_matches "$pid" xbox-accel; then
		kill_tree "$pid"
		# Let the worker persist its terminal record before procd sends another TERM.
		for attempt in 1 2 3; do
			process_matches "$pid" xbox-accel || break
			sleep 1
		done
	fi
	ubus call service delete '{"name":"xbox-accel-task"}' >/dev/null 2>&1
	rm -f "$RUN_DIR/task.pid"
	if ! process_matches "$pid" xbox-accel; then finish_cancelled_record; fi
	flock -u 9
	return 0
}

# ---------- 解析实例配置 ----------

pin() {
	echo "host-record=$1,$2"
	echo "local=/$1/"
}

pin_exact() {
	pin "$1" "$2"
	# 子域例外保留正常上游；精确名称的 AAAA 返回正常 NODATA。
	echo "server=/*.$1/#"
}

srv_rules() {
	local n
	for n in $SRV_NAMES; do
		echo "srv-host=$n,assets1.xboxlive.com,80,0,1000"
		echo "local=/$n/"
	done
}

gen_resolver_conf() {
	local s d ip target g
	echo "# 由 xbox-accel 生成，请勿手工修改"
	echo "port=$(cfg resolver_port 5335)"
	echo "listen-address=127.0.0.1"
	echo "bind-interfaces"
	echo "no-resolv"
	echo "no-hosts"
	echo "no-poll"
	echo "cache-size=0"
	echo "local-ttl=$(to_int "$(cfg ttl 30)")"
	echo "pid-file=$RUN_DIR/dnsmasq.pid"
	echo 'log-queries'
	echo "log-facility=$TMP_DIR/dns-observation.log"
	# 没有被固定的域名照常向这些 DNS 查询
	for s in $(cfg fallback_dns "223.5.5.5 119.29.29.29" | tr ' ' '\n' | ipv4s); do
		echo "server=$s"
	done

	if cfg_bool optimize_cn 1 && ip=$(best_ip cn); then
		for d in $(best_domains cn); do pin "$d" "$ip"; done
	fi

	case "$(com_mode)" in
	redirect)
		target=$(redirect_ip)
		for d in $COM_DOMAINS $COM_DL_DOMAINS; do pin "$d" "$target"; done
		cfg_bool override_cdn_hosts 1 && for d in $CDN_HOSTS; do pin "$d" "$target"; done
		srv_rules
		;;
	optimize)
		if ip=$(best_ip com) && best_domains com | grep -qw 'assets1.xboxlive.com'; then
			for d in $(best_domains com); do pin "$d" "$ip"; done
			cfg_bool override_cdn_hosts 1 && for d in $CDN_HOSTS; do pin "$d" "$ip"; done
			srv_rules
		fi
		;;
	esac
	# 固定精确名称并为其余子域保留上游查询。
	for g in $PLATFORM_GROUPS; do
		if cfg_bool "optimize_$g" 0 && ip=$(best_ip "$g"); then
			for d in $(pinned_domains "$g"); do pin_exact "$d" "$ip"; done
		fi
	done
}

write_resolver_conf() {
	local new="$RESOLVER_CONF.new"
	mkdir -p "${RESOLVER_CONF%/*}" "$RUN_DIR" "$TMP_DIR"
	gen_resolver_conf >"$new"
	/usr/sbin/dnsmasq --test -C "$new" >/dev/null 2>&1 || { rm -f "$new"; die "生成的解析配置无效，保留旧配置"; }
	if cmp -s "$new" "$RESOLVER_CONF" 2>/dev/null; then
		rm -f "$new"
	else
		mv "$new" "$RESOLVER_CONF"
		: >"$RUN_DIR/cache_flush_needed"
	fi
}

# ---------- 主 dnsmasq 的固定规则 ----------

main_domains() {
	local g
	cfg_bool optimize_cn 1 && echo "$CN_DOMAINS"
	case "$(com_mode)" in
	off) ;;
	*)
		echo "$COM_DOMAINS $COM_DL_DOMAINS $SRV_NAMES"
		cfg_bool override_cdn_hosts 1 && echo "$CDN_HOSTS"
		;;
	esac
	for g in $PLATFORM_GROUPS; do cfg_bool "optimize_$g" 0 && pinned_domains "$g"; done
	return 0
}

main_rules_now() {
	uci -q get "dhcp.$DNS_INSTANCE.server" | tr ' ' '\n' | grep .
}

# sync_main 1|0：0=有变化，1=保持原样，2=同步失败（保留所有权记录）。
sync_main() {
	local want=$1 port desired e changed=1 old now known
	local DNS_INSTANCE="$DNS_INSTANCE" previous_instance
	previous_instance=$(cat "$STATE_DIR/main_instance" 2>/dev/null)
	if [ "$want" = 0 ] && [ -n "$previous_instance" ]; then
		DNS_INSTANCE=$previous_instance
	elif [ -n "$previous_instance" ] && [ "$previous_instance" != "$DNS_INSTANCE" ]; then
		die "修改主 dnsmasq 实例前必须先停用插件，撤销旧实例规则"
	fi
	uci -q get "dhcp.$DNS_INSTANCE" >/dev/null || { note "找不到 dhcp.$DNS_INSTANCE，无法写入解析规则"; return 2; }
	mkdir -p "$STATE_DIR" || return 2
	port=$(cfg resolver_port 5335)
	desired=""
	[ "$want" = 1 ] && desired=$(main_domains | tr ' ' '\n' | grep . | sed "s|.*|/&/127.0.0.1#$port|" | uniq_keep_order)
	now=$(main_rules_now)
	# “本插件写入的规则”= 上次记录的规则，加上配置里现存的、域名在本插件名单内
	# 且指向本插件端口的规则（上次操作被中断时记录可能不完整）
	known=$(for e in $CN_DOMAINS $COM_DOMAINS $COM_DL_DOMAINS $SRV_NAMES $CDN_HOSTS $PLATFORM_DOMAINS; do echo "/$e/127.0.0.1#$port"; done)
	old=$({
		cat "$STATE_DIR/main_rules" 2>/dev/null
		pending_cleanup_rules
		for e in $now; do echo "$known" | grep -qxF "$e" && echo "$e"; done
	} | uniq_keep_order)

	# 删除本插件以前写入、现在不需要的规则（同一条可能被别的程序复制成多条）
	for e in $old; do
		echo "$desired" | grep -qxF "$e" && continue
		while main_rules_now | grep -qxF "$e"; do
			mark_main_reload || return 2
			uci -q del_list "dhcp.$DNS_INSTANCE.server=$e" || return 2
			changed=0
		done
	done
	for e in $desired; do
		echo "$now" | grep -qxF "$e" && continue
		mark_main_reload || return 2
		uci -q add_list "dhcp.$DNS_INSTANCE.server=$e" || return 2
		changed=0
	done
	mkdir -p "$STATE_DIR"
	# 302 模式返回内网地址，仅为明确接管的下载域名放行重绑定保护。
	# 记录本插件实际新增的条目，卸载时不删除用户原先的例外。
	local rd desired_rd="" owned_rd remaining_rd="" existing_rd
	owned_rd=$(cat "$STATE_DIR/rebind_domains" 2>/dev/null)
	existing_rd=$(uci -q get "dhcp.$DNS_INSTANCE.rebind_domain")
	if [ "$want" = 1 ] && [ "$(com_mode)" = redirect ]; then
		desired_rd="$COM_DOMAINS $COM_DL_DOMAINS"
		cfg_bool override_cdn_hosts 1 && desired_rd="$desired_rd $CDN_HOSTS"
	fi
	for rd in $owned_rd; do
		if echo " $desired_rd " | grep -qF " $rd "; then
			remaining_rd="$remaining_rd $rd"
		else
			if echo " $existing_rd " | grep -qF " $rd "; then
				mark_main_reload || return 2
				uci -q del_list "dhcp.$DNS_INSTANCE.rebind_domain=$rd" || return 2
				changed=0
			fi
		fi
	done
	existing_rd=$(uci -q get "dhcp.$DNS_INSTANCE.rebind_domain")
	for rd in $desired_rd; do
		echo " $existing_rd " | grep -qF " $rd " && continue
		mark_main_reload || return 2
		uci -q add_list "dhcp.$DNS_INSTANCE.rebind_domain=$rd" || return 2
		remaining_rd="$remaining_rd $rd"
		changed=0
	done
	if [ "$changed" = 0 ] || [ -e "$STATE_DIR/main_reload_needed" ]; then
		uci -q commit dhcp || return 2
		changed=0
	fi
	if [ -n "$remaining_rd" ]; then
		echo "$remaining_rd" | tr ' ' '\n' | grep . | uniq_keep_order >"$STATE_DIR/rebind_domains"
	else
		rm -f "$STATE_DIR/rebind_domains"
	fi
	if [ -n "$desired" ]; then
		echo "$desired" >"$STATE_DIR/main_rules"
		echo "$DNS_INSTANCE" >"$STATE_DIR/main_instance"
	else
		rm -f "$STATE_DIR/main_rules" "$STATE_DIR/main_instance"
	fi
	return $changed
}

mark_main_reload() {
	[ -e "$STATE_DIR/main_reload_needed" ] || : >"$STATE_DIR/main_reload_needed"
}

# 清理记录同时保存在持久目录和运行目录，升级时兼容旧版运行记录。
pending_cleanup_rules() {
	cat "$STATE_DIR/pending_rules" "$RUN_DIR/pending_rules" 2>/dev/null | uniq_keep_order
}

remember_cleanup() {
	local rules=$1 instance=${2:-} new="$STATE_DIR/pending_rules.new.$$" copies
	mkdir -p "$STATE_DIR" "$RUN_DIR" || return 1
	{ pending_cleanup_rules; printf '%s\n' "$rules"; } | grep . | uniq_keep_order >"$new" || { rm -f "$new"; return 1; }
	mv "$new" "$STATE_DIR/pending_rules" || return 1
	cp "$STATE_DIR/pending_rules" "$RUN_DIR/pending_rules" || return 1
	[ -z "$instance" ] || printf '%s\n' "$instance" >"$STATE_DIR/pending_instance" || return 1
	# 规则移除后仍保留副本配置路径，用于刷新仍在运行的任意名称副本。
	copies=$(passwall_dnsmasq_confs)
	{ cat "$STATE_DIR/dns_copies" 2>/dev/null; printf '%s\n' "$copies"; } | grep . | uniq_keep_order >"$new" || { rm -f "$new"; return 1; }
	mv "$new" "$STATE_DIR/dns_copies" || return 1
	return 0
}

# 使用运行中的可执行文件身份识别 dnsmasq，包括任意改名、软链接和二进制副本。
# cmp 同时支持已经删除或改名、仍在运行的原二进制；整个过程只读取文件。
dnsmasq_process() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	cmp -s "/proc/$1/exe" /usr/sbin/dnsmasq
}

# 按 NUL 边界解析参数，覆盖 -C FILE、-CFILE、--conf-file FILE/FILE=。
dnsmasq_process_confs() {
	local pid=$1 conf base
	tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | awk '
		NR==1 {next}
		nextconf {if ($0 != "") print; nextconf=0; next}
		$0=="-C" || $0=="--conf-file" {nextconf=1; seen=1; next}
		/^--conf-file=/ {sub(/^--conf-file=/, ""); if ($0!="") print; seen=1; next}
		/^-C./ {sub(/^-C/, ""); print; seen=1}
		END {if (!seen) print "/etc/dnsmasq.conf"}
	' | while IFS= read -r conf; do
		case "$conf" in /*) base="/proc/$pid/root" ;; *) base="/proc/$pid/cwd/" ;; esac
		readlink -f "$base$conf" 2>/dev/null
	done | uniq_keep_order
}

# 以已记录的规则所有权识别任意路径下的副本；Passwall 目录也参与新增规则同步。
passwall_dnsmasq_confs() {
	local p pid conf owned e recorded mains section id
	recorded=$(cat "$STATE_DIR/dns_copies" 2>/dev/null)
	mains=$(uci -q show dhcp 2>/dev/null | awk -F= '$2=="dnsmasq" {print $1}' | while IFS= read -r section; do
		id=$(uci -q show "$section" 2>/dev/null | awk -F '[.=]' 'NR==1{print $2}')
		[ -n "$id" ] && readlink -f "/var/etc/dnsmasq.conf.$id"
	done)
	owned=$({ cat "$STATE_DIR/main_rules" 2>/dev/null; pending_cleanup_rules;
		for e in $CN_DOMAINS $COM_DOMAINS $COM_DL_DOMAINS $SRV_NAMES $CDN_HOSTS $PLATFORM_DOMAINS; do echo "/$e/127.0.0.1#$(cfg resolver_port 5335)"; done;
	} | uniq_keep_order)
	for p in /proc/[0-9]*; do
		pid=${p##*/}
		dnsmasq_process "$pid" || continue
		dnsmasq_process_confs "$pid" | while IFS= read -r conf; do
			[ "$conf" = "$(readlink -f "$RESOLVER_CONF")" ] && continue
			printf '%s\n' "$mains" | grep -qxF "$conf" && continue
			case "$conf" in */passwall/*|*/passwall2/*) printf '%s\n' "$conf"; continue ;; esac
			printf '%s\n' "$recorded" | grep -qxF "$conf" && { printf '%s\n' "$conf"; continue; }
			for e in $owned; do
				if grep -qxF "server=$e" "$conf" 2>/dev/null; then printf '%s\n' "$conf"; break; fi
			done
		done
	done | grep . | uniq_keep_order
}

# 副本仍有已撤销的规则时返回 0；只匹配本插件拥有的规则。
passwall_has_stale_rules() {
	local stale_rules="$1" conf e miss=1 desired copies
	desired=$(cat "$STATE_DIR/main_rules" 2>/dev/null)
	copies=$(passwall_dnsmasq_confs)
	while IFS= read -r conf; do
		[ -n "$conf" ] || continue
		[ -r "$conf" ] || return 0
		# 停用前保留的所有权记录也参与检查，避免修改端口后漏掉旧副本。
		for e in $stale_rules; do
			echo "$desired" | grep -qxF "$e" && continue
			grep -qxF "server=$e" "$conf" && miss=0
		done
		# 只认本插件域名，不能把同端口的用户规则当成本插件残留。
		for e in $CN_DOMAINS $COM_DOMAINS $COM_DL_DOMAINS $SRV_NAMES $CDN_HOSTS $PLATFORM_DOMAINS; do
			e="/$e/127.0.0.1#$(cfg resolver_port 5335)"
			echo "$desired" | grep -qxF "$e" && continue
			grep -qxF "server=$e" "$conf" && miss=0
		done
	done <<EOF
$copies
EOF
	return $miss
}

passwall_out_of_sync() {
	local conf e desired copies
	passwall_has_stale_rules "$1" && return 0
	desired=$(cat "$STATE_DIR/main_rules" 2>/dev/null)
	copies=$(passwall_dnsmasq_confs)
	while IFS= read -r conf; do
		[ -n "$conf" ] || continue
		[ -r "$conf" ] || return 0
		for e in $desired; do
			grep -qxF "server=$e" "$conf" || return 0
		done
	done <<EOF
$copies
EOF
	return 1
}

sync_passwall() {
	local stale_rules="$1" cleanup=0 services service conf copies
	passwall_out_of_sync "$stale_rules" || return 0
	passwall_has_stale_rules "$stale_rules" && cleanup=1
	# 撤销功能时始终重新载入副本，确保用户关闭后立即恢复原解析。
	# passwall_restart 仅控制启用时新增规则的自动同步。
	if [ "$cleanup" = 1 ] || cfg_bool passwall_restart 1; then
		copies=$(passwall_dnsmasq_confs)
		services=$(printf '%s\n' "$copies" | awk 'NF {if (index($0,"/passwall2/")) print "passwall2"; else print "passwall"}' | uniq_keep_order)
		for service in ${services:-passwall}; do
			service="/etc/init.d/$service"
			[ -x "$service" ] || { note "DNS 副本重载入口缺失：$service；保留清理记录"; return 1; }
			note "DNS 副本需要重新载入解析规则：$service"
			svc "$service" restart || { note "DNS 副本重载失败：$service；保留清理记录"; return 1; }
		done
		# 重启后直连集合被重建，把当前节点加回去
		[ -s "$STATE_DIR/main_rules" ] && passwall_direct $(selected_ips)
		if passwall_out_of_sync "$stale_rules"; then
			note "Passwall 的 DNS 副本仍有规则不同步，请检查 Passwall 重载日志"
			return 1
		fi
	else
		note "Passwall 的 DNS 副本规则待同步，请重载 Passwall"
		[ "$cleanup" = 1 ] && return 1
	fi
	return 0
}

# ---------- 旧版主 uhttpd 配置的迁移清理 ----------

sync_uhttpd() {
	local cur
	uci -q get uhttpd.main >/dev/null || {
		[ ! -e "$STATE_DIR/uhttpd_pending" ] && [ ! -e "$STATE_DIR/uhttpd_error_page" ]
		return $?
	}
	cur=$(uci -q get uhttpd.main.error_page)
	[ "$cur" = "$CGI_URL" ] || [ -e "$STATE_DIR/uhttpd_pending" ] || [ -e "$STATE_DIR/uhttpd_error_page" ] || return 0
	mkdir -p "$STATE_DIR" || return 1
	: >"$STATE_DIR/uhttpd_pending" || return 1
	if [ "$cur" = "$CGI_URL" ]; then
		if [ -s "$STATE_DIR/uhttpd_error_page" ]; then
			uci -q set "uhttpd.main.error_page=$(cat "$STATE_DIR/uhttpd_error_page")" || return 1
		else
			uci -q delete uhttpd.main.error_page || return 1
		fi
	fi
	uci -q commit uhttpd || return 1
	svc /etc/init.d/uhttpd restart || return 1
	rm -f "$STATE_DIR/uhttpd_pending" "$STATE_DIR/uhttpd_error_page"
	return 0
}

# ---------- 定时任务 ----------

sync_cron() {
	local want=$1 new="$TMP_DIR/cron.new" sched hi rc
	mkdir -p "$TMP_DIR" "$STATE_DIR" "${CRON_FILE%/*}" || return 1
	touch "$CRON_FILE" || return 1
	grep -vF "$CRON_TAG" "$CRON_FILE" >"$new"
	rc=$?; [ "$rc" -le 1 ] || return 1
	if [ "$want" = 1 ]; then
		sched=$(schedule_cron) || die "定时测速计划无效"
		[ -n "$sched" ] && echo "$sched /usr/bin/xbox-accel start_test all scheduled >/dev/null 2>&1 $CRON_TAG" >>"$new"
		hi=$(to_int "$(cfg health_interval 10)")
		[ "$hi" -gt 0 ] && [ "$hi" -lt 60 ] &&
			echo "*/$hi * * * * /usr/bin/xbox-accel health >/dev/null 2>&1 $CRON_TAG" >>"$new"
	fi
	if cmp -s "$new" "$CRON_FILE"; then
		rm -f "$new"
		[ -e "$STATE_DIR/cron_reload_needed" ] || return 0
	else
		: >"$STATE_DIR/cron_reload_needed" || return 1
		cat "$new" >"$CRON_FILE" || return 1
		rm -f "$new"
	fi
	svc /etc/init.d/cron enable || return 1
	svc /etc/init.d/cron restart || return 1
	rm -f "$STATE_DIR/cron_reload_needed"
	return 0
}

# ---------- 由 init 脚本调用 ----------

# 当前真正生效的分组：国内优选；国际域名处于优选模式时的国际优选
groups_active() {
	local g
	cfg_bool optimize_cn 1 && echo cn
	[ "$(com_mode)" = optimize ] && echo com
	for g in $PLATFORM_GROUPS; do cfg_bool "optimize_$g" 0 && echo "$g"; done
	return 0
}

setup() {
	local why previous_rules main_rc
	validate_config
	apply_lock
	migrate_redirect_ip || return 1
	sync_uhttpd 0 || return 1
	previous_rules=$(cat "$STATE_DIR/main_rules" 2>/dev/null)
	# 保存旧端口与被关闭的分组规则，直到运行中的副本已完成重载。
	if [ -n "$previous_rules" ]; then
		remember_cleanup "$previous_rules" "$(cat "$STATE_DIR/main_instance" 2>/dev/null)" || return 1
	fi
	if cfg_bool redirect_cn 0; then
		why=$(redirect_blocker)
		[ -z "$why" ] || { note "独立重定向服务准备失败：$why"; return 1; }
	fi
	if [ "$(com_mode)" = redirect ]; then sync_redirect 1; else sync_redirect 0; fi || return 1
	write_resolver_conf
	sync_main 1; main_rc=$?
	case "$main_rc" in 0) svc /etc/init.d/dnsmasq restart || return 1; rm -f "$STATE_DIR/main_reload_needed" ;; 1) ;; *) return 1 ;; esac
	sync_cron 1 || return 1
	passwall_direct $(selected_ips)
	com_mode >"$RUN_DIR/applied_mode"
	groups_active >"$RUN_DIR/applied_groups"
	return 0
}

# 解析实例就绪后再检查 Passwall，避免它重启时规则指向一个还没起来的端口
post_start() {
	local g attempt missing=1
	apply_lock
	if [ "$(cat "$RUN_DIR/applied_mode" 2>/dev/null)" = redirect ]; then
		for attempt in 1 2 3 4 5; do
			redirect_ready && redirect_firewall_ready && break
			sleep 1
		done
		redirect_ready && redirect_firewall_ready || { note '独立重定向监听或转发规则尚未就绪'; return 1; }
		redirect_pids | head -n 1 >"$RUN_DIR/redirect.pid"
	fi
	sync_passwall "$(pending_cleanup_rules)" || return 1
	if [ "$(cat "$RUN_DIR/applied_mode" 2>/dev/null)" = redirect ]; then redirect_firewall_ready || sync_redirect 1 || return 1; fi
	if [ -f "$RUN_DIR/cache_flush_needed" ] || [ -s "$STATE_DIR/pending_rules" ] || [ -s "$RUN_DIR/pending_rules" ]; then
		flush_front_cache || return 1
		rm -f "$RUN_DIR/cache_flush_needed"
	fi
	rm -f "$STATE_DIR/pending_rules" "$STATE_DIR/pending_instance" "$RUN_DIR/pending_rules" "$STATE_DIR/dns_copies"
	# 启用后还没有测速结果时立即测一次，不必等到定时任务
	for g in $(groups_active); do
		group_result_ready "$g" || missing=0
	done
	if [ "$missing" = 0 ] && ! task_running; then
		(start_task all first_run) >/dev/null 2>&1 7>&-
	fi
	return 0
}

teardown() {
	local cleanup_instance stale_rules result=0 main_rc
	apply_lock
	cancel_task
	# sync_main 会移除状态文件；提前记住旧实例和旧端口的规则。
	cleanup_instance=$(cat "$STATE_DIR/main_instance" 2>/dev/null)
	[ -n "$cleanup_instance" ] || cleanup_instance=$(cat "$STATE_DIR/pending_instance" 2>/dev/null)
	stale_rules=$({ cat "$STATE_DIR/main_rules" 2>/dev/null; pending_cleanup_rules; } | uniq_keep_order)
	# 清理失败时保留所有权记录，重复停用仍可追踪旧端口的规则。
	if [ -n "$stale_rules" ]; then remember_cleanup "$stale_rules" "$cleanup_instance" || return 1; fi
	sync_main 0; main_rc=$?
	case "$main_rc" in
	0) if svc /etc/init.d/dnsmasq restart; then rm -f "$STATE_DIR/main_reload_needed"; else result=1; fi ;;
	1) ;; *) result=1 ;;
	esac
	sync_uhttpd 0 || result=1
	sync_redirect 0 || result=1
	sync_cron 0 || result=1
	sync_passwall "$stale_rules" || result=1
	# 即使规则早已移除（或重复停用），前置 DNS 仍可能缓存旧地址。
	flush_front_cache "${cleanup_instance:-$DNS_INSTANCE}" || result=1
	if [ "$result" = 0 ]; then
		rm -f "$RESOLVER_CONF" "$RUN_DIR/applied_mode" "$RUN_DIR/applied_groups" "$RUN_DIR/cache_flush_needed" "$RUN_DIR/pending_rules" "$STATE_DIR/pending_rules" "$STATE_DIR/pending_instance" "$STATE_DIR/dns_copies"
	fi
	return "$result"
}

is_enabled() { cfg_bool enabled 0; }

apply() {
	if is_enabled; then
		apply_and_verify
	else
		TASK_APPLY_STATUS=skipped; TASK_APPLY_CODE=DISABLED; TASK_APPLY_MESSAGE='插件未启用，结果只保存未应用'
		say "服务未启用：结果已保存，启用后生效"
		return 0
	fi
}

# 依据实际二进制和完整配置路径识别实例，PID 文件仅提供状态缓存。
resolver_process() {
	dnsmasq_process "$1" || return 1
	dnsmasq_process_confs "$1" | grep -qxF "$(readlink -f "$RESOLVER_CONF")"
}

resolver_pids() {
	local process pid
	for process in /proc/[0-9]*; do
		pid=${process##*/}
		resolver_process "$pid" && echo "$pid"
	done
	return 0
}

resolver_running() {
	[ -n "$(resolver_pids)" ]
}

# procd 停止后查验实际进程，兼容注册信息或 PID 文件遗失的情况。
stop_resolver() {
	local pid before after attempt signal
	for signal in TERM KILL; do
		for pid in $(resolver_pids); do
			[ "$pid" -gt 1 ] || continue
			before=$(sed 's/^[0-9]* (.*) //' "/proc/$pid/stat" 2>/dev/null | awk '{print $20}')
			resolver_process "$pid" || continue
			after=$(sed 's/^[0-9]* (.*) //' "/proc/$pid/stat" 2>/dev/null | awk '{print $20}')
			[ -n "$before" ] && [ "$before" = "$after" ] || continue
			kill -"$signal" "$pid" 2>/dev/null
		done
		for attempt in 1 2 3 4 5; do
			if ! resolver_running; then
				[ -z "$RUN_DIR" ] || rm -f "$RUN_DIR/dnsmasq.pid"
				return 0
			fi
			sleep 1
		done
	done
	note "[SERVICE_STOP_INCOMPLETE] 插件解析进程仍在运行，请检查进程状态"
	return 1
}

# SIGHUP 只重新读 hosts/resolv 并清空缓存，不重启 DNS/DHCP 服务。
# 按实际可执行文件和完整配置路径匹配，PID 文件仅作为服务状态信息。
flush_front_cache() {
	local instance="${1:-$DNS_INSTANCE}" id f pid conf confs match copies main result=0 start before
	id=$(uci -q show "dhcp.$instance" | awk -F '[.=]' 'NR==1{print $2}')
	# 主实例被删也必须清空实际运行的 Passwall 副本缓存。
	copies=$(passwall_dnsmasq_confs)
	main=$(readlink -f "/var/etc/dnsmasq.conf.$id")
	for f in /proc/[0-9]*; do
		pid=${f##*/}
		dnsmasq_process "$pid" || continue
		before=$(cat "$f/stat" 2>/dev/null) || continue
		match=0
		confs=$(dnsmasq_process_confs "$pid")
		[ -n "$id" ] && printf '%s\n' "$confs" | grep -qxF "$main" && match=1
		while IFS= read -r conf; do
			[ -n "$conf" ] || continue
			printf '%s\n' "$confs" | grep -qxF "$(readlink -f "$conf")" && match=1
		done <<EOF
$copies
EOF
		[ "$match" = 1 ] || continue
		# stat 的启动时间可识别 PID 重用；发信号前重新核对进程身份与参数。
		start=$(printf '%s\n' "$before" | sed 's/^[0-9]* (.*) //' | awk '{print $20}')
		[ "$start" = "$(sed 's/^[0-9]* (.*) //' "$f/stat" 2>/dev/null | awk '{print $20}')" ] && dnsmasq_process "$pid" || continue
		[ "$confs" = "$(dnsmasq_process_confs "$pid")" ] || continue
		if ! kill -HUP "$pid" 2>/dev/null && [ -d "$f" ]; then
			note "DNS 缓存清理失败：PID=$pid；保留记录供重试"
			result=1
		fi
	done
	return "$result"
}

# 已应用的状态与当前应有的状态不一致时返回 0：解析实例退出、主 dnsmasq 里的规则
# 被其他程序改掉、重定向的前置条件发生变化
drifted() {
	local e now
	resolver_running || return 0
	[ "$(cat "$RUN_DIR/applied_mode" 2>/dev/null)" = "$(com_mode)" ] || return 0
	[ "$(cat "$RUN_DIR/applied_groups" 2>/dev/null)" = "$(groups_active)" ] || return 0
	if [ "$(com_mode)" = redirect ]; then
		redirect_ready && redirect_firewall_ready || return 0
	else
		redirect_running && return 0
		redirect_firewall_present && return 0
	fi
	now=$(main_rules_now)
	for e in $(cat "$STATE_DIR/main_rules" 2>/dev/null); do
		echo "$now" | grep -qxF "$e" || return 0
	done
	return 1
}

# ---------- 解析查询 ----------

# q_a 域名 服务器[:端口] → A 记录，空格分隔
q_a() {
	nslookup -type=a -timeout=1 -retry=1 "$1" "$2" 2>/dev/null |
		awk '/^Name:/{f=1} f && /^Address/{print $NF}' | ipv4s | tr '\n' ' ' | sed 's/ $//'
}

# 有 AAAA 记录时返回 0
has_aaaa() {
	nslookup -type=aaaa -timeout=1 -retry=1 "$1" "$2" 2>/dev/null |
		awk '/^Name:/{f=1} f && /^Address/{print $NF}' | grep -q ':'
}

# 该域名经本插件处理后应得到的地址；不处理时无输出
expected_ip() {
	case "$1" in
	cn) cfg_bool optimize_cn 1 && best_domains cn | grep -qw assets1.xboxlive.cn && best_ip cn ;;
	com)
		case "$(com_mode)" in
		redirect) redirect_ip ;;
		optimize) best_domains com | grep -qw assets1.xboxlive.com && best_ip com ;;
		esac
		;;
	store|ps|xbox_old|switch) cfg_bool "optimize_$1" 0 && [ -n "$(pinned_domains "$1")" ] && best_ip "$1" ;;
	esac
}

# 局域网客户端的 DNS 请求被防火墙重定向到的端口（Passwall 等会这样做）
dns_redirect_ports() {
	{
		nft -t list ruleset 2>/dev/null | grep -E 'dport 53 ' | grep -oE 'redirect to :[0-9]+' | grep -oE '[0-9]+$'
		iptables-save -t nat 2>/dev/null | grep -E -- '--dport 53 ' | grep -oE -- '--to-ports [0-9]+' | grep -oE '[0-9]+$'
	} | uniq_keep_order
}

listeners_53() {
	netstat -lnup 2>/dev/null | awk '$4 ~ /:53$/ {sub(/^[0-9]*\//, "", $NF); print $NF}' | uniq_keep_order | tr '\n' ' ' | sed 's/ $//'
}

passwall_state() {
	if nft list table inet passwall >/dev/null 2>&1 || { command -v ipset >/dev/null 2>&1 && ipset list -n psw_white >/dev/null 2>&1; }; then
		echo running
	elif [ -x /etc/init.d/passwall ]; then
		echo stopped
	elif [ -x /etc/init.d/passwall2 ]; then
		echo passwall2
	else
		echo none
	fi
}

in_passwall_direct() {
	if nft list set inet passwall psw_white >/dev/null 2>&1; then
		nft get element inet passwall psw_white "{ $1 }" >/dev/null 2>&1
	else
		ipset test psw_white "$1" >/dev/null 2>&1
	fi
}

# ---------- LuCI / rpcd ----------

json_status() {
	. /usr/share/libubox/jshn.sh
	local g last d configured verified game_status mapped defaults total domains
	json_init
	json_add_string version "$VERSION"
	json_add_string log_mode "$LOG_MODE"
	json_add_string resolver_port "$(cfg resolver_port 5335)"
	if is_enabled; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi
	if resolver_running; then json_add_boolean running 1; else json_add_boolean running 0; fi
	if task_running; then json_add_boolean testing 1; else json_add_boolean testing 0; fi
	json_add_string mode "$(com_mode)"
	if cfg_bool optimize_cn 1; then json_add_boolean optimize_cn 1; else json_add_boolean optimize_cn 0; fi
	json_add_string lan_ip "$(lan_ip)"
	json_add_string redirect_ip "$(redirect_ip)"
	json_add_string redirect_port "$(redirect_port)"
	if redirect_running; then
		json_add_boolean redirect_running 1
		if redirect_ready; then json_add_boolean redirect_ready 1; else json_add_boolean redirect_ready 0; fi
	else json_add_boolean redirect_running 0; json_add_boolean redirect_ready 0; fi
	for g in $ALL_GROUPS; do
		json_add_string "${g}_ip" "$(best_ip "$g")"
		last=$(cat "$TMP_DIR/last_$g" 2>/dev/null)
		set -- $last
		json_add_string "${g}_speed" "${2:+$(fmt_speed "$2")}"
		json_add_int "${g}_time" "$(to_int "$3")"
	done
	json_add_object platforms
	for g in $PLATFORM_GROUPS; do
		json_add_object "$g"
		json_add_string label "$(group_label "$g")"
		if cfg_bool "optimize_$g" 0; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi
		json_add_string ip "$(best_ip "$g")"
		last=$(cat "$TMP_DIR/last_$g" 2>/dev/null); set -- $last
		json_add_string speed "${2:+$(fmt_speed "$2")}"; json_add_int time "$(to_int "$3")"
		domains=$(pinned_domains "$g" | tr '\n' ' ' | sed 's/ *$//')
		json_add_string domains "$domains"
		if [ "$g" = store ]; then json_add_int resource_expires_at "$(to_int "$(store_url_expiry "$(group_url store)")")"; fi
		if [ "$g" = switch ]; then
			configured=0; verified=0; mapped=0; defaults=0; total=0
			for d in $SWITCH_GAME_DOMAINS; do
				total=$((total+1))
				if domain_url switch "$d" >/dev/null; then configured=$((configured+1)); fi
				case " $domains " in *" $d "*)
					mapped=$((mapped+1))
					if domain_url switch "$d" >/dev/null; then verified=$((verified+1)); else defaults=$((defaults+1)); fi ;;
				esac
			done
			game_status=pending; [ "$configured" = 0 ] && game_status=default
			[ "$configured" -gt 0 ] && [ "$verified" = "$configured" ] && game_status=verified
			json_add_string game_status "$game_status"
			json_add_int game_configured "$configured"; json_add_int game_verified "$verified"
			json_add_int game_mapped "$mapped"; json_add_int game_default_mapped "$defaults"; json_add_int game_total "$total"
		fi
		json_close_object
	done
	json_close_object
	json_add_string log "$(display_log)"
	if [ -s "$LOG_FILE" ]; then json_add_string log_source live;
	elif [ -s "$STATE_DIR/activity-last.log" ]; then json_add_string log_source persisted;
	else json_add_string log_source none; fi
	json_append_document last_task "$(last_task_document)" 1
	json_append_document last_test "$(last_speed_document)" 1
	append_measurements
	append_application_summary
	json_append_document observation "$(observation_document)"
	json_add_boolean report_ready "$(report_available && echo 1 || echo 0)"
	json_add_string report_file "$REPORT_FILE"
	json_dump
}

env_row() { # 名称 级别（ok|info|warn|fail） 说明
	json_add_object ""
	json_add_string name "$1"
	json_add_string level "$2"
	json_add_string detail "$3"
	json_close_object
}

# 逐项检测运行环境。这里的检测都在路由器本机进行，无法代替在 Xbox 上的实际验证。
json_env() {
	diagnostic_environment
}

# ---------- 命令 ----------

cmd_test() {
	local g only=${1:-all} intent=${2:-apply} groups success=0 failed=0 partial=0 result=1 application_rc=0
	TEST_MODE=$intent; TASK_KIND=test
	[ "$intent" = measure ] && TASK_KIND=measure
	lock
	task_begin
	[ "$TASK_MEMORY_READY" = 1 ] || die "无法记录任务摘要，已停止测速"
	task_stage configuration
	TASK_CODE=CONFIG_INVALID; TASK_MESSAGE='配置校验未通过'
	if [ "$intent" = measure ]; then
		groups=$(measurement_groups "$only") || die '请选择有效的测速平台'
		validate_measurement_config "$groups"
	else
		validate_config
		case "$only" in all|cn|com|store|ps|xbox_old|switch) ;; *) die "未知测速组：$only" ;; esac
		groups=$(groups_active)
	fi
	TASK_CODE=RUNNING
	for g in $groups; do
		[ "$intent" != measure ] && [ "$only" != all ] && [ "$only" != "$g" ] && continue
		if test_group "$g"; then success=$((success+1)); partial=$((partial+${TEST_GROUP_PARTIAL:-0})); else failed=$((failed+1)); fi
	done
	if [ "$success" -eq 0 ]; then
		if [ "$failed" -eq 0 ]; then
			TASK_STATUS=skipped; TASK_CODE=NO_ENABLED_GROUP; TASK_MESSAGE='请求的测速功能未开启，没有执行'
		else
			TASK_STATUS=failed; TASK_CODE=ALL_GROUPS_FAILED; TASK_MESSAGE='所有请求组失败；旧节点未替换'
		fi
		return 1
	fi
	if [ "$intent" = measure ]; then
		TASK_APPLY_STATUS=skipped; TASK_APPLY_CODE=MEASUREMENT_ONLY; TASK_APPLY_MESSAGE='独立测速结果已保存，采用结果时应用配置'
	elif is_enabled; then
		task_stage apply
		apply; application_rc=$?
		if [ "$application_rc" = 1 ]; then
			TASK_STATUS=failed; TASK_CODE=APPLICATION_FAILED; TASK_MESSAGE="$TASK_APPLY_MESSAGE"
			return 1
		fi
	else
		TASK_APPLY_STATUS=skipped; TASK_APPLY_CODE=DISABLED; TASK_APPLY_MESSAGE='插件未启用，只保存测速结果'
	fi
	if [ "$failed" -gt 0 ] || [ "$partial" -gt 0 ] || [ "$application_rc" = 2 ]; then
		TASK_STATUS=partial; TASK_CODE=PARTIAL_RESULT; TASK_MESSAGE='部分组失败或配置尚未全部验收；查看分组与验收详情'; result=2
	else
		TASK_STATUS=success; TASK_CODE=TEST_COMPLETED; TASK_MESSAGE='采样完成，应用和设备下载状态见总览'; result=0
		[ "$intent" != measure ] || { TASK_CODE=MEASUREMENT_READY; TASK_MESSAGE='独立测速完成，请在结果中选择采用'; }
	fi
	task_stage finished
	say "测速结束：status=$TASK_STATUS success_groups=$success failed_groups=$failed"
	return "$result"
}

cmd_health() {
	local g ip url changed=1 try ok now last success=0 failed=0 partial=0 application_rc=0
	is_enabled || return 0
	TASK_KIND=health; TASK_TRIGGER=health
	lock; task_begin
	[ "$TASK_MEMORY_READY" = 1 ] || die "无法记录健康检查摘要，已停止"
	validate_config
	task_stage health
	if drifted; then
		task_event WARN CONFIG_DRIFT '解析实例或主规则与应有状态不一致，准备修复'
		changed=0
	fi
	for g in $(groups_active); do
		ip=$(best_ip "$g")
		if ! group_result_ready "$g"; then
			now=$(date +%s); last=$(to_int "$(cat "$TMP_DIR/retry_$g" 2>/dev/null)")
			if [ $((now-last)) -lt 1800 ]; then
				group_report "$g" skipped RETRY_BACKOFF '没有可用节点；尚未到重试时间'
				continue
			fi
			echo "$now" >"$TMP_DIR/retry_$g"
			if test_group "$g"; then changed=0; success=$((success+1)); partial=$((partial+${TEST_GROUP_PARTIAL:-0})); else failed=$((failed+1)); fi
			continue
		fi
		if ! prepare_group_resource "$g"; then
			group_report "$g" failed "$GROUP_RESOURCE_CODE" "$GROUP_RESOURCE_MESSAGE" "$ip"
			task_event WARN "$GROUP_RESOURCE_CODE" "group=$g $GROUP_RESOURCE_MESSAGE"
			failed=$((failed+1)); continue
		fi
		passwall_direct "$ip"; ok=1
		for try in 1 2 3; do
			if group_alive "$g" "$ip"; then ok=0; break; fi
			if [ "$g" = store ] && [ "$try" = 1 ]; then prepare_group_resource store force || break; fi
			sleep 3
		done
		if [ "$ok" = 0 ]; then
			group_report "$g" success HEALTH_OK '当前节点资源检查通过；本次未重新测量速度' "$ip"
			success=$((success+1)); continue
		fi
		task_event WARN HEALTH_FAILED "group=$g ip=$ip 连续三次资源检查失败，准备重测"
		if test_group "$g"; then changed=0; success=$((success+1)); partial=$((partial+${TEST_GROUP_PARTIAL:-0})); else failed=$((failed+1)); fi
	done
	if [ "$changed" = 0 ]; then
		task_stage apply
		apply; application_rc=$?
		if [ "$application_rc" = 1 ]; then
			TASK_STATUS=failed; TASK_CODE=APPLICATION_FAILED; TASK_MESSAGE="$TASK_APPLY_MESSAGE"
			return 1
		elif [ "$application_rc" = 2 ]; then
			TASK_STATUS=partial; TASK_CODE=ROUTER_NOT_FULLY_VERIFIED; TASK_MESSAGE="$TASK_APPLY_MESSAGE"
			return 2
		fi
	else
		TASK_APPLY_STATUS=skipped; TASK_APPLY_CODE=NO_CHANGE; TASK_APPLY_MESSAGE='本次没有修改配置，不代表重新验收链路'
	fi
	if [ "$failed" -gt 0 ] || [ "$partial" -gt 0 ]; then
		TASK_STATUS=failed; [ "$success" -gt 0 ] && TASK_STATUS=partial
		TASK_CODE=HEALTH_OR_RETEST_FAILED; TASK_MESSAGE='部分健康检查或重新测速失败，旧配置按分组保留'
		return 1
	fi
	TASK_STATUS=success; TASK_CODE=HEALTH_COMPLETED; TASK_MESSAGE='健康检查完成；不等于 Xbox 下载效果已确认'
	[ "$success" -gt 0 ] || { TASK_STATUS=skipped; TASK_CODE=NOT_DUE; TASK_MESSAGE='本次无需执行健康检查'; }
	return 0
}


cmd_status() {
	local g ip last port pid
	port=$(cfg resolver_port 5335)
	say "xbox-accel $VERSION"
	if is_enabled; then say "服务：已启用"; else say "服务：未启用"; fi
	pid=$(cat "$RUN_DIR/dnsmasq.pid" 2>/dev/null)
	if resolver_running; then
		say "解析实例：运行中（127.0.0.1:$port，PID $pid）"
	else
		say "解析实例：未运行"
	fi
	cfg_bool optimize_cn 1 && say "国内域名：优选" || say "国内域名：不处理"
	case "$(com_mode)" in
	redirect) say "国际域名：重定向到国内（入口 $(redirect_ip):80，独立服务 $(lan_ip):$(redirect_port)）" ;;
	optimize) say "国际域名：优选" ;;
	off) say "国际域名：不处理" ;;
	esac
	cfg_bool redirect_cn 0 && [ -n "$(redirect_blocker)" ] && say "  重定向未生效：$(redirect_blocker)"
	for g in $ALL_GROUPS; do
		ip=$(best_ip "$g") || { say "[$(group_label "$g")] 还没有测速结果"; continue; }
		last=$(cat "$TMP_DIR/last_$g" 2>/dev/null)
		if [ -n "$last" ]; then
			set -- $last
			say "[$g] 节点 $ip，$(fmt_speed "$2")，测于 $(date -d "@$3" '+%m-%d %H:%M' 2>/dev/null || echo "$3")"
		else
			say "[$g] 节点 $ip（重启后尚未复测）"
		fi
		say "      已固定域名：$(best_domains "$g")"
	done
	say "主 dnsmasq 规则：$(cat "$STATE_DIR/main_rules" 2>/dev/null | grep -c .) 条"
	if is_enabled; then
		say "经主 dnsmasq 查询："
		say "  assets1.xboxlive.cn  → $(q_a assets1.xboxlive.cn 127.0.0.1)"
		say "  assets1.xboxlive.com → $(q_a assets1.xboxlive.com 127.0.0.1)"
	fi
}

cmd_check() {
	local out keys k name level detail mark code expected observed result router measurement direct_set saved_log_active
	cmd_application_task verify; result=$?
	out=$(application_report_document)
	. /usr/share/libubox/jshn.sh
	jshn -r "$out" >/dev/null 2>&1 && json_load "$out" || die "环境检测没有返回完整有效 JSON，不能确认成功"
	# 终端报告直接输出；任务日志已按采集模式记录验收项。
	saved_log_active=$LOG_ACTIVE; LOG_ACTIVE=0
	json_select environment
	json_get_keys keys
	for k in $keys; do
		json_select "$k"
		json_get_var name name
		json_get_var level level
		json_get_var detail detail
		json_get_var code code
		json_get_var expected expected
		json_get_var observed observed
		json_select ..
		case "$level" in
		ok) mark="[ 正常 ]" ;;
		warn) mark="[ 注意 ]" ;;
		fail) mark="[ 异常 ]" ;;
		unknown) mark="[ 未确认 ]" ;;
		skipped) mark="[ 未执行 ]" ;;
		*) mark="[ 信息 ]" ;;
		esac
		say "$mark [$code] $name：$detail"
		[ -z "$expected" ] || say "  预期=$expected；实际=${observed:-无结果}"
	done
	json_select ..; json_select summary
	json_get_var router router; json_get_var measurement measurement; json_get_var direct_set direct_set
	say
	say "验收结果：路由器=$router；测试资源=${measurement:-skipped}；直连集合=${direct_set:-skipped}；任务=$TASK_STATUS（exit=$result）"
	say "客户端 DNS 与下载路径请在局域网设备和 Xbox 上确认；建议运行 nslookup assets1.xboxlive.cn $(lan_ip)"
	LOG_ACTIVE=$saved_log_active
	return "$result"
}

cmd_enable() {
	uci -q set "$NAME.main.enabled=1" && uci -q commit "$NAME" || die "无法写入配置"
	"$INIT" enable || return 1
	"$INIT" restart || return 1
	cmd_status
}

cmd_disable() {
	uci -q set "$NAME.main.enabled=0" && uci -q commit "$NAME" || die "无法写入配置"
	"$INIT" stop || return 1
	say "已停用：主 dnsmasq 规则、302 入口和定时任务均已移除"
}

cmd_reset() {
	cancel_task
	rm -f "$STATE_DIR"/best_* "$STATE_DIR"/domains_* "$STATE_DIR"/resources_* "$TMP_DIR"/last_* "$TMP_DIR/store-resource.json"
	if is_enabled; then "$INIT" reload 7>&- 8>&- 9>&- || return 1; fi
	say "已停止任务并清除当前节点；历史摘要保留。尚未重新测速，不能宣称加速生效。"
}

usage() {
	cat <<EOF
xbox-accel $VERSION

用法：xbox-accel <命令>
  test [cn|com|store|ps|xbox_old|switch]  发现候选节点、测速、选优并应用
  start_test     后台自动选优并应用，供计划任务和旧版 CLI 使用
  measure [平台,平台|all]  独立测速并保存候选，支持关闭的功能
  start_measure  后台独立测速
  start_adopt <平台> <结果ID>  启用功能、采用候选并验收
  cancel         停止正在运行的后台任务
  status         查看当前模式、节点和解析结果
  check          环境检测：DNS 链路、解析结果、重定向、定时任务、Passwall
  start_verify   后台完整验收，完成后查看任务摘要
  start_restart  后台重启服务并验收当前配置
  start_report   后台生成脱敏报告 /tmp/xbox-accel/diagnostic-report.json
  clear_log      清空运行日志和已保存的历史日志快照
  enable         启用功能（开机恢复按自启动设置执行）
  disable        停用并撤销对系统的全部改动
  health         检查当前节点是否可用，不可用则重新测速
  reset          清除测速结果，恢复默认解析
EOF
}

case "$1" in -v|--version) echo "$VERSION"; exit 0 ;; esac
case "$1" in
_service) shift; run_service_action "$@"; exit $? ;;
_stop_resolver) stop_resolver; exit $? ;;
esac
[ -r "$SHARE_DIR/redirect.sh" ] || { echo '错误：重定向模块缺失，请重新安装插件' >&2; exit 1; }
. "$SHARE_DIR/redirect.sh"
case "$1" in
_stop_redirect) stop_redirect; exit $? ;;
_restore_redirect) restore_redirect_firewall; exit $? ;;
_web_guard) web_guard; exit $? ;;
esac
[ -r "$SHARE_DIR/platforms.sh" ] || { echo '错误：平台模块缺失，请重新安装插件' >&2; exit 1; }
. "$SHARE_DIR/platforms.sh"
if [ ! -r "$SHARE_DIR/diagnostics.sh" ]; then
	echo "错误：诊断模块缺失，请重新安装插件" >&2
	exit 1
fi
. "$SHARE_DIR/diagnostics.sh"
for diagnostic_module in verification application privacy quick-check measurement records observation; do
	[ -r "$SHARE_DIR/$diagnostic_module.sh" ] || { echo "错误：诊断模块 $diagnostic_module 缺失，请重新安装" >&2; exit 1; }
	. "$SHARE_DIR/$diagnostic_module.sh"
done

case "$1" in
test) cmd_test "$2" ;;
measure) cmd_test "${2:-all}" measure ;;
health) cmd_health ;;
status) cmd_status ;;
check) cmd_check ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
reset) cmd_reset ;;
cancel) cancel_task ;;
start_test)
	validate_config
	start_task "${2:-all}" "${3:-manual_cli}"
	;;
start_measure) start_task measure "${3:-manual_cli}" "${2:-all}" ;;
start_adopt) start_task adopt "${4:-manual_ui}" "$2" "$3" ;;
clear_log)
	mkdir -p "$TMP_DIR"
	: >"$LOG_FILE"
	rm -f "$STATE_DIR/activity-last.log"
	clear_event_records
	;;
json_status) json_status ;;
json_env) json_env ;;
json_preflight) quick_environment ;;
json_records) json_records ;;
_observe) observation_loop ;;
start_apply)
	missing=0
	if is_enabled; then for group in $(groups_active); do group_result_ready "$group" || missing=1; done; fi
	if [ "$missing" = 1 ]; then start_task all first_run; else start_task apply "${2:-manual_ui}"; fi
	;;
start_verify) start_task verify "${2:-manual_ui}" ;;
start_restart) start_task restart "${2:-manual_ui}" ;;
start_report) start_task report "${2:-manual_ui}" ;;
_worker)
	mkdir -p "$TMP_DIR"
	QUIET=1
	exec >>"$LOG_FILE" 2>&1
	TASK_ID=${4:-}; TASK_TRIGGER=${3:-manual_ui}
	case "$2" in
	apply|restart|verify) cmd_application_task "$2" ;;
	report) cmd_report_task ;;
	measure) cmd_test "${5:-all}" measure ;;
	adopt) cmd_adopt_measurement "$5" "$6" ;;
	*) TASK_KIND=test; cmd_test "$2" ;;
	esac
	;;
_validate) validate_config ;;
_setup) setup ;;
_post_start) post_start ;;
_teardown) teardown ;;
-v | --version) echo "$VERSION" ;;
*) usage ;;
esac
