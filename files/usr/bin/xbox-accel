#!/bin/sh
# xbox-accel: Xbox 下载 CDN 优选 + com→cn 重定向（OpenWrt）
# 结构：主 dnsmasq 只写固定规则，把 Xbox 下载域名交给本插件的解析实例；
#       换节点、切模式只改解析实例的配置，不动主 dnsmasq。

VERSION=0.2.2
NAME=xbox-accel
STATE_DIR=/etc/xbox-accel
RUN_DIR=/var/run/xbox-accel
TMP_DIR=/tmp/xbox-accel
RESOLVER_CONF=/var/etc/xbox-accel/dnsmasq.conf
SHARE_DIR=/usr/share/xbox-accel
INIT=/etc/init.d/xbox-accel
CGI_URL=/cgi-bin/xbox-accel-redirect
CRON_FILE=/etc/crontabs/root
CRON_TAG='# xbox-accel'

# 国内下载域名
CN_DOMAINS="assets1.xboxlive.cn assets2.xboxlive.cn d1.xboxlive.cn d2.xboxlive.cn"
# 国际下载域名
COM_DOMAINS="assets1.xboxlive.com assets2.xboxlive.com d1.xboxlive.com d2.xboxlive.com xvcf1.xboxlive.com xvcf2.xboxlive.com"
# 国际老游戏下载域名：只在重定向模式下接管（跳到 dlassets.xboxlive.cn）
COM_DL_DOMAINS="dlassets.xboxlive.com dlassets2.xboxlive.com"
# 主机通过 SRV 记录拿到的备用 CDN 主机名
CDN_HOSTS="5.xb.delivery.microsoft.com assets1.xboxlive.com.edgesuite.net cl-glcb907925.gcdn.co fg.microsoft.map.fastly.net"
# 返回上述 SRV 记录的名字
SRV_NAMES="assets-srvs.xboxlive.com assets-srvs-net.trafficmanager.net assets-srvs-apac.delivery.microsoft.com"

DEF_URL_CN="http://assets1.xboxlive.cn/Z/routing/extraextralarge.txt"
DEF_URL_COM="http://assets1.xboxlive.com/Z/routing/extraextralarge.txt"

LOG_FILE=$TMP_DIR/activity.log
LOG_ACTIVE=0 # 1：同时写入任务日志（LuCI 页面显示的就是它）
QUIET=0      # 1：后台任务，标准输出和错误输出已经重定向到任务日志

stamp() { date '+%m-%d %H:%M:%S'; }

say() {
	if [ "$QUIET" = 1 ]; then
		printf '%s %s\n' "$(stamp)" "$*"
	else
		echo "$*"
		[ "$LOG_ACTIVE" = 1 ] && printf '%s %s\n' "$(stamp)" "$*" >>"$LOG_FILE"
	fi
	return 0
}

note() {
	say "$*"
	logger -t "$NAME" -- "$*" 2>/dev/null
	return 0
}

die() {
	if [ "$QUIET" = 1 ]; then
		printf '%s 错误：%s\n' "$(stamp)" "$*"
	else
		echo "错误：$*" >&2
		[ "$LOG_ACTIVE" = 1 ] && printf '%s 错误：%s\n' "$(stamp)" "$*" >>"$LOG_FILE"
	fi
	exit 1
}

# 任务日志放在内存文件系统里，只保留最近 500 行
rotate_log() {
	[ -f "$LOG_FILE" ] || return 0
	[ "$(wc -l <"$LOG_FILE")" -gt 500 ] || return 0
	tail -n 500 "$LOG_FILE" >"$LOG_FILE.new" && cat "$LOG_FILE.new" >"$LOG_FILE"
	rm -f "$LOG_FILE.new"
}

# 运行其他服务的脚本时关闭本进程持有的锁：它们拉起的常驻进程会继承已打开的文件，
# 锁一旦被继承就永远不会释放。
svc() { "$@" >/dev/null 2>&1 7>&- 8>&- 9>&-; }

cfg() {
	local v
	v=$(uci -q get "$NAME.main.$1") || v=
	if [ -n "$v" ]; then echo "$v"; else echo "$2"; fi
}

schedule_label() {
	local plan
	plan=$(cfg cron '15 5 * * *')
	case "$plan" in
	'*/30 * * * *') echo '每 30 分钟（每小时 00、30 分）' ;;
	'0 * * * *') echo '每小时整点' ;;
	'0 */3 * * *') echo '每 3 小时（00、03、06、09、12、15、18、21 点）' ;;
	'0 */6 * * *') echo '每 6 小时（00、06、12、18 点）' ;;
	'0 */12 * * *') echo '每 12 小时（00、12 点）' ;;
	'0 3 * * 0') echo '每周日 03:00' ;;
	*) printf '%s\n' "$plan" | awk '{if(NF==5 && $1~/^[0-9]+$/ && $2~/^[0-9]+$/ && $3=="*" && $4=="*" && $5=="*") printf "每天 %02d:%02d\n",$2,$1; else print "保留的自定义计划"}' ;;
	esac
}

health_label() {
	cfg health_interval 10 | awk '{if($0!~/^[0-9]+$/){print "设置无效，请重新选择"; exit} v=$0+0; if(v==0) print "关闭"; else if(v>0 && v<60 && 60%v==0) printf "每 %d 分钟\n",v; else if(v>0 && v<60) {printf "每小时 "; for(i=0;i<60;i+=v) printf "%s%02d", i?"、":"", i; print " 分"} else print "设置无效，请重新选择"}'
}

DNS_INSTANCE=$(cfg dnsmasq_instance '@dnsmasq[0]')
# 支持选择主实例；如果启用期间切换实例，先要求停用旧实例避免遗留规则。

cfg_bool() {
	case "$(cfg "$1" "$2")" in
	1 | on | true | yes | enabled) return 0 ;;
	*) return 1 ;;
	esac
}

# 从标准输入提取合法 IPv4，每行一个
ipv4s() {
	grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | awk -F. '$1<=255 && $2<=255 && $3<=255 && $4<=255'
}

# 只保留公网地址：CDN 节点不可能是内网、环回或保留地址
public_only() {
	awk -F. '
		$1==0 || $1==10 || $1==127 || $1>=224 { next }
		$1==100 && $2>=64 && $2<=127 { next }
		$1==169 && $2==254 { next }
		$1==172 && $2>=16 && $2<=31 { next }
		$1==192 && $2==168 { next }
		$1==198 && ($2==18 || $2==19) { next }
		{ print }'
}

uniq_keep_order() { awk '!seen[$0]++'; }

to_int() {
	local v=${1%%.*}
	case "$v" in '' | *[!0-9]*) echo 0 ;; *) echo "$v" ;; esac
}

fmt_speed() {
	awk -v b="$1" 'BEGIN { printf "%.2f MB/s（%.0f Mbps）", b/1000000, b*8/1000000 }'
}

url_host() { local u=${1#http://}; echo "${u%%/*}"; }
url_path() { local u=${1#http://}; echo "/${u#*/}"; }

group_url() {
	case "$1" in
	cn) cfg test_url_cn "$DEF_URL_CN" ;;
	com) cfg test_url_com "$DEF_URL_COM" ;;
	esac
}

group_offset() { to_int "$(cfg "test_offset_$1" 0)"; }

best_ip() {
	local ip
	ip=$(cat "$STATE_DIR/best_$1" 2>/dev/null | ipv4s | head -n 1)
	[ -n "$ip" ] && echo "$ip"
}

best_domains() { cat "$STATE_DIR/domains_$1" 2>/dev/null; }

lan_ip() {
	local ip
	ip=$(cfg redirect_ip "")
	[ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr | awk '{print $1}')
	[ -n "$ip" ] || ip=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2; exit}')
	echo "${ip%%/*}" | ipv4s | head -n 1
}

port_available() {
	local hex inode fd ours pid listeners
	hex=$(printf '%04X' "$1")
	listeners=$(awk -v port=":$hex" '$2 ~ (port "$" ) && ($4=="0A" || FILENAME ~ /udp/) {print $10}' /proc/net/tcp /proc/net/tcp6 /proc/net/udp /proc/net/udp6 2>/dev/null)
	[ -n "$listeners" ] || return 0
	pid=$(cat "$RUN_DIR/dnsmasq.pid" 2>/dev/null)
	process_matches "$pid" "$RESOLVER_CONF" || return 1
	for inode in $listeners; do
		ours=0
		for fd in /proc/"$pid"/fd/*; do
			[ "$(readlink "$fd" 2>/dev/null)" = "socket:[$inode]" ] && ours=1 && break
		done
		[ "$ours" = 1 ] || return 1
	done
	return 0
}

# 修改系统配置前拒绝无效参数，尤其防止解析回环和 cron 注入。
validate_config() {
	local port s schedule url host g spec key min max v
	for spec in 'quick_size_mb:1:128:4' 'full_size_mb:1:256:64' 'quick_time:1:30:4' 'full_time:1:60:10' 'top_n:1:10:3' 'max_candidates:1:100:60' 'switch_threshold:0:100:15' 'ttl:5:600:30' 'health_interval:0:59:10'; do
		key=${spec%%:*}; spec=${spec#*:}; min=${spec%%:*}; spec=${spec#*:}; max=${spec%%:*}
		v=$(cfg "$key" "${spec#*:}")
		case "$v" in ''|*[!0-9]*) die "$key 必须是整数" ;; esac
		[ "$v" -ge "$min" ] && [ "$v" -le "$max" ] || die "$key 超出范围 $min..$max"
	done
	printf '%s' "$DNS_INSTANCE" | grep -qE '^(@dnsmasq\[[0-9]+\]|[A-Za-z0-9_]+)$' || die "主实例名称无效"
	[ "$(uci -q get "dhcp.$DNS_INSTANCE")" = dnsmasq ] || die "所选主 dnsmasq 实例不存在"
	command -v flock >/dev/null || die "缺少 flock"
	port=$(cfg resolver_port 5335)
	case "$port" in ''|*[!0-9]*) die "resolver_port 必须是整数" ;; esac
	[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || die "resolver_port 必须在 1024..65535"
	port_available "$port" || die "独立解析端口 $port 被其他服务占用"
	for s in $(cfg fallback_dns "223.5.5.5 119.29.29.29"); do
		[ "$(printf '%s' "$s" | ipv4s | public_only)" = "$s" ] || die "fallback_dns 只允许公网 IPv4，避免回环"
	done
	schedule=$(cfg cron "15 5 * * *")
	[ "$(printf '%s' "$schedule" | tr -d '0-9*/ ,\055')" = "" ] || die "cron 含非法字符"
	set -f
	set -- $schedule
	set +f
	[ "$#" = 5 ] || die "cron 必须有五个字段"
	printf '%s\n' "$schedule" | awk '
	function valid(f,lo,hi, n,a,i,k,b,c,step,x,y) {
	 n=split(f,a,","); for(i=1;i<=n;i++) {
	  k=split(a[i],b,"/"); if(k>2||k<1) return 0;
	  if(k==2&&(b[2]!~/^[0-9]+$/||b[2]<1||b[2]>hi+1)) return 0;
	  if(b[1]=="*") continue;
	  k=split(b[1],c,"-"); if(k>2||k<1) return 0;
	  if(c[1]!~/^[0-9]+$/||c[1]<lo||c[1]>hi) return 0;
	  if(k==2&&(c[2]!~/^[0-9]+$/||c[2]<lo||c[2]>hi||c[2]<c[1])) return 0;
	 } return 1;
	}
	{exit !(NF==5&&valid($1,0,59)&&valid($2,0,23)&&valid($3,1,31)&&valid($4,1,12)&&valid($5,0,7))}' || die "cron 字段值或范围无效"
	for g in cn com; do
		url=$(group_url "$g")
		host=$(url_host "$url")
		[ "$host" = "assets1.xboxlive.$g" ] || die "测速 URL 必须使用 http://assets1.xboxlive.$g/ 路径"
	done
}

# ---------- 重定向（com→cn）前置条件 ----------

# 输出不能启用的原因；可以启用时无输出
redirect_blocker() {
	[ -x /usr/sbin/uhttpd ] || { echo "未安装 uhttpd"; return; }
	uci -q get uhttpd.main >/dev/null || { echo "找不到 uhttpd.main 配置"; return; }
	uci -q get uhttpd.main.listen_http | tr ' ' '\n' | grep -qE ':80$' ||
		{ echo "uhttpd 没有监听 80 端口"; return; }
	[ "$(uci -q get uhttpd.main.redirect_https)" = 1 ] &&
		{ echo "uhttpd 开启了强制跳转 HTTPS（redirect_https）"; return; }
	[ -x "/www$CGI_URL" ] || { echo "缺少 /www$CGI_URL"; return; }
	[ -n "$(lan_ip)" ] || { echo "无法确定路由器 LAN IP，请设置 redirect_ip"; return; }
}

# 国际域名的工作模式：redirect / optimize / off
com_mode() {
	if cfg_bool redirect_cn 0 && [ -z "$(redirect_blocker)" ]; then
		echo redirect
	elif cfg_bool optimize_com 1; then
		echo optimize
	else
		echo off
	fi
}

# ---------- Passwall 直连 ----------

# 把 IP 加入 Passwall 的直连集合；没有 Passwall 时什么都不做
passwall_direct() {
	local ip
	cfg_bool passwall_direct 1 || return 0
	[ $# -gt 0 ] || return 0
	if command -v nft >/dev/null 2>&1 && nft list set inet passwall psw_white >/dev/null 2>&1; then
		for ip in "$@"; do
			# 先删后加可以刷新过期时间；元素不存在时退回到直接添加
			printf 'delete element inet passwall psw_white { %s }\nadd element inet passwall psw_white { %s }\n' "$ip" "$ip" |
				nft -f - 2>/dev/null ||
				nft add element inet passwall psw_white "{ $ip }" 2>/dev/null
		done
	elif command -v ipset >/dev/null 2>&1 && ipset list -n psw_white >/dev/null 2>&1; then
		for ip in "$@"; do
			ipset -! add psw_white "$ip" timeout 0 2>/dev/null || ipset -! add psw_white "$ip" 2>/dev/null
		done
	fi
	return 0
}

# ---------- 候选发现 ----------

isp_dns() {
	local f
	for f in /tmp/resolv.conf.d/resolv.conf.auto /tmp/resolv.conf.auto; do
		[ -f "$f" ] && awk '$1=="nameserver"{print $2}' "$f"
	done | ipv4s | grep -v '^127\.' | uniq_keep_order
}

# 运营商对应的参考网段：用于向 HTTPDNS 询问“该运营商其他地区会分到哪些节点”
ecs_subnets() {
	local isp
	isp=$(cfg isp auto)
	case "$isp" in
	telecom | unicom | mobile)
		[ -f "$SHARE_DIR/ecs.$isp" ] && grep -v '^#' "$SHARE_DIR/ecs.$isp" | awk '{print $1}'
		;;
	esac
	cfg ecs_subnet "" | tr ' ' '\n'
}

discover() {
	local group=$1 hosts servers h s e i=0 d="$TMP_DIR/discover.$$"
	case "$group" in
	cn) hosts="assets1.xboxlive.cn" ;;
	com) hosts="assets1.xboxlive.com $CDN_HOSTS" ;;
	esac
	rm -rf "$d"
	mkdir -p "$d"

	# 1. 本线路：公共 DNS 与运营商下发的 DNS 按来源 IP 返回本线路节点
	servers=$(cfg probe_dns "223.5.5.5 119.29.29.29 114.114.114.114 180.76.76.76")
	cfg_bool use_isp_dns 1 && servers="$servers $(isp_dns | tr '\n' ' ')"
	for s in $(echo "$servers" | tr ' ' '\n' | ipv4s | uniq_keep_order); do
		for h in $hosts; do
			i=$((i + 1))
			(nslookup "$h" "$s" 2>/dev/null | ipv4s | grep -vxF "$s" >"$d/a$i") &
		done
	done
	# 2. HTTPDNS：本线路，以及按运营商参考网段扩展的候选
	for h in $hosts; do
		i=$((i + 1))
		(curl -s --noproxy '*' -m 6 "http://119.29.29.29/d?dn=$h" 2>/dev/null | tr ';,' '\n\n' | ipv4s >"$d/b$i") &
	done
	for e in $(ecs_subnets | ipv4s | uniq_keep_order); do
		for h in $hosts; do
			i=$((i + 1))
			(curl -s --noproxy '*' -m 6 "http://119.29.29.29/d?dn=$h&ip=$e" 2>/dev/null | tr ';,' '\n\n' | ipv4s >"$d/c$i") &
		done
	done
	wait
	cat "$d"/a* "$d"/b* "$d"/c* 2>/dev/null
	rm -rf "$d"
}

candidates() {
	local group=$1 max
	max=$(to_int "$(cfg max_candidates 60)")
	[ "$max" -gt 0 ] || max=60
	{
		best_ip "$group"
		discover "$group"
		[ -f "$STATE_DIR/candidates_$group" ] && ipv4s <"$STATE_DIR/candidates_$group"
		cfg_bool use_seeds 1 && [ -f "$SHARE_DIR/seeds.$group" ] && ipv4s <"$SHARE_DIR/seeds.$group"
	} | public_only | uniq_keep_order | head -n "$max"
}

# ---------- 测速 ----------

# probe IP HOST PATH OFFSET BYTES TIMEOUT → “状态码 已下载字节 平均速度(B/s)”
probe() {
	local end=$(($4 + $5 - 1))
	curl -s -o /dev/null --noproxy '*' --connect-timeout 3 -m "$6" -r "$4-$end" \
		--resolve "$2:80:$1" -w '%{http_code} %{size_download} %{speed_download}' \
		"http://$2$3" 2>/dev/null
}

# alive IP HOST PATH OFFSET：取 1KB 判断节点是否正常提供该文件
alive() {
	set -- $(probe "$1" "$2" "$3" "$4" 1024 6)
	[ "$1" = 206 ] && [ "$(to_int "$2")" -ge 1024 ]
}

# 测一批 IP：stage_run 输出文件 最小有效字节 字节数 超时 HOST PATH OFFSET IP...
stage_run() {
	local out=$1 minb=$2 bytes=$3 tmo=$4 host=$5 path=$6 off=$7 ip r code got speed
	shift 7
	: >"$out"
	for ip in "$@"; do
		r=$(probe "$ip" "$host" "$path" "$off" "$bytes" "$tmo")
		set -- $r
		code=${1:-000}
		got=$(to_int "$2")
		speed=$(to_int "$3")
		if [ "$code" = 206 ] && [ "$got" -ge "$minb" ]; then
			echo "$speed $ip" >>"$out"
			say "  $ip  $(fmt_speed "$speed")"
		else
			say "  $ip  不可用（HTTP $code，收到 $got 字节）"
		fi
	done
}

verify_domains() {
	local group=$1 ip=$2 path off d list ok=""
	path=$(url_path "$(group_url "$group")")
	off=$(group_offset "$group")
	case "$group" in cn) list=$CN_DOMAINS ;; com) list=$COM_DOMAINS ;; esac
	for d in $list; do
		alive "$ip" "$d" "$path" "$off" && ok="$ok $d"
	done
	echo $ok
}

test_group() {
	local group=$1 url host path off cands count qs qb qt fs fb ft topn thr
	local q="$TMP_DIR/quick_$group" f="$TMP_DIR/full_$group"
	local tops cur best best_ip_ best_speed cur_speed chosen chosen_speed doms

	url=$(group_url "$group")
	host=$(url_host "$url")
	path=$(url_path "$url")
	off=$(group_offset "$group")
	qb=$(($(to_int "$(cfg quick_size_mb 4)") * 1048576))
	qt=$(to_int "$(cfg quick_time 4)")
	fb=$(($(to_int "$(cfg full_size_mb 64)") * 1048576))
	ft=$(to_int "$(cfg full_time 10)")
	topn=$(to_int "$(cfg top_n 3)")
	thr=$(to_int "$(cfg switch_threshold 15)")
	[ "$qb" -gt 0 ] && [ "$qt" -gt 0 ] && [ "$fb" -gt 0 ] && [ "$ft" -gt 0 ] && [ "$topn" -gt 0 ] ||
		{ note "[$group] 测速参数无效，跳过"; return 1; }

	say "[$group] 测速文件：$url"
	cands=$(candidates "$group")
	count=$(echo "$cands" | grep -c .)
	[ "$count" -gt 0 ] || { note "[$group] 没有找到候选节点，保留现有配置"; return 1; }
	passwall_direct $cands

	say "[$group] 初筛 $count 个候选（每个最多 $(cfg quick_size_mb 4) MB / ${qt} 秒）"
	stage_run "$q" 131072 "$qb" "$qt" "$host" "$path" "$off" $cands
	[ -s "$q" ] || { note "[$group] 所有候选都不可用，保留现有配置"; return 1; }

	cur=$(best_ip "$group")
	tops=$(sort -rn "$q" | head -n "$topn" | awk '{print $2}')
	# 当前节点仍可用时一定参加复测，否则无法判断是否值得切换
	if [ -n "$cur" ] && grep -q " $cur\$" "$q" && ! echo "$tops" | grep -qxF "$cur"; then
		tops="$tops $cur"
	fi

	say "[$group] 复测（每个最多 $(cfg full_size_mb 64) MB / ${ft} 秒）"
	stage_run "$f" 1048576 "$fb" "$ft" "$host" "$path" "$off" $tops
	[ -s "$f" ] || { note "[$group] 复测全部失败，保留现有配置"; return 1; }

	best=$(sort -rn "$f" | head -n 1)
	best_speed=${best%% *}
	best_ip_=${best##* }
	chosen=$best_ip_
	chosen_speed=$best_speed
	cur_speed=""
	[ -n "$cur" ] && cur_speed=$(awk -v ip="$cur" '$2==ip{print $1; exit}' "$f")
	# 新节点没有明显更快就不切换，避免来回抖动
	if [ -n "$cur_speed" ] && [ "$cur" != "$best_ip_" ] &&
		[ $((best_speed * 100)) -le $((cur_speed * (100 + thr))) ]; then
		chosen=$cur
		chosen_speed=$cur_speed
		say "[$group] 最快节点 $best_ip_ 未超过当前节点 ${thr}%，保持 $cur"
	fi

	mkdir -p "$STATE_DIR"
	if [ "$chosen" != "$cur" ] || [ ! -s "$STATE_DIR/domains_$group" ]; then
		doms=$(verify_domains "$group" "$chosen")
		[ -n "$doms" ] || { note "[$group] 节点 $chosen 未通过域名校验，保留现有配置"; return 1; }
		echo "$doms" >"$STATE_DIR/domains_$group"
		echo "$chosen" >"$STATE_DIR/best_$group"
		note "[$group] 选用节点 $chosen，$(fmt_speed "$chosen_speed")${cur:+（原节点 $cur）}"
	else
		say "[$group] 节点不变：$chosen，$(fmt_speed "$chosen_speed")"
	fi
	echo "$chosen $chosen_speed $(date +%s)" >"$TMP_DIR/last_$group"
	return 0
}

groups_enabled() {
	cfg_bool optimize_cn 1 && echo cn
	cfg_bool optimize_com 1 && echo com
}

# ---------- 互斥锁与后台任务 ----------

process_matches() {
	case "$1" in '' | *[!0-9]*) return 1 ;; esac
	[ -r "/proc/$1/cmdline" ] || return 1
	tr '\0' ' ' <"/proc/$1/cmdline" | grep -qF -- "$2"
}

task_running() { process_matches "$(cat "$RUN_DIR/task.pid" 2>/dev/null)" xbox-accel; }

# 测速与健康检查互斥
lock() {
	mkdir -p "$RUN_DIR" "$TMP_DIR"
	exec 8>"$RUN_DIR/task.lock"
	flock -n 8 || die "已有测速或健康检查正在运行"
	echo $$ >"$RUN_DIR/task.pid"
	LOG_ACTIVE=1
	trap 'rotate_log; rm -f "$RUN_DIR/task.pid"; rm -rf "$TMP_DIR"/discover.*' EXIT
	trap 'note "任务被停止"; exit 130' INT TERM
}

# 对系统配置的改动（主 dnsmasq 规则、uhttpd、cron）串行执行
apply_lock() {
	local n=0
	mkdir -p "$RUN_DIR"
	exec 7>"$RUN_DIR/apply.lock"
	until flock -n 7; do
		n=$((n + 1))
		[ "$n" -le 90 ] || die "等待其他配置操作超时"
		sleep 1
	done
}

# 后台任务交给 procd 运行，不依赖浏览器页面或 SSH 会话
start_task() {
	local kind=${1:-all}
	case "$kind" in all | cn | com) ;; *) die "未知任务：$kind" ;; esac
	mkdir -p "$RUN_DIR"
	exec 9>"$RUN_DIR/launch.lock"
	flock -n 9 || die "另一个任务正在启动"
	if task_running || ubus call service list '{"name":"xbox-accel-task"}' 2>/dev/null | grep -q '"running": true'; then
		die "已有任务在运行，请等待完成或先停止"
	fi
	rm -f "$RUN_DIR/task.pid"
	# procd 不会重新启动已经退出、参数又没有变化的实例，先移除旧实例
	ubus call service delete '{"name":"xbox-accel-task"}' >/dev/null 2>&1
	initscript=/usr/bin/xbox-accel
	service_triggers() { :; }
	. /lib/functions/procd.sh
	procd_open_service xbox-accel-task /usr/bin/xbox-accel
	procd_open_instance worker
	procd_set_param command /usr/bin/xbox-accel _worker "$kind"
	procd_set_param env PATH="$PATH"
	procd_close_instance
	procd_close_service
}

ppid_of() { sed -n 's/^[0-9]* (.*) [A-Za-z] \([0-9]*\) .*/\1/p' "/proc/$1/stat" 2>/dev/null; }

children_of() {
	local f
	for f in /proc/[0-9]*/stat; do
		sed -n "s/^\([0-9][0-9]*\) (.*) [A-Za-z] $1 .*/\1/p" "$f" 2>/dev/null
	done
}

# 只终止确认属于该任务的进程及其子进程，不按名字批量杀 curl
kill_tree() {
	local c
	for c in $(children_of "$1"); do kill_tree "$c"; done
	kill -TERM "$1" 2>/dev/null
	return 0
}

is_ancestor() {
	local p=$$
	while [ -n "$p" ] && [ "$p" -gt 1 ]; do
		[ "$p" = "$1" ] && return 0
		p=$(ppid_of "$p")
	done
	return 1
}

cancel_task() {
	local pid
	pid=$(cat "$RUN_DIR/task.pid" 2>/dev/null)
	# 任务自己触发的重载不能反过来杀掉任务
	[ -n "$pid" ] && is_ancestor "$pid" && return 0
	process_matches "$pid" xbox-accel && kill_tree "$pid"
	ubus call service delete '{"name":"xbox-accel-task"}' >/dev/null 2>&1
	rm -f "$RUN_DIR/task.pid"
	return 0
}

# ---------- 解析实例配置 ----------

pin() {
	echo "host-record=$1,$2"
	echo "local=/$1/"
}

srv_rules() {
	local n
	for n in $SRV_NAMES; do
		echo "srv-host=$n,assets1.xboxlive.com,80,0,1000"
		echo "local=/$n/"
	done
}

gen_resolver_conf() {
	local s d ip target
	echo "# 由 xbox-accel 生成，请勿手工修改"
	echo "port=$(cfg resolver_port 5335)"
	echo "listen-address=127.0.0.1"
	echo "bind-interfaces"
	echo "no-resolv"
	echo "no-hosts"
	echo "no-poll"
	echo "cache-size=0"
	echo "local-ttl=$(to_int "$(cfg ttl 30)")"
	echo "pid-file=$RUN_DIR/dnsmasq.pid"
	# 没有被固定的域名照常向这些 DNS 查询
	for s in $(cfg fallback_dns "223.5.5.5 119.29.29.29" | tr ' ' '\n' | ipv4s); do
		echo "server=$s"
	done

	if cfg_bool optimize_cn 1 && ip=$(best_ip cn); then
		for d in $(best_domains cn); do pin "$d" "$ip"; done
	fi

	case "$(com_mode)" in
	redirect)
		target=$(lan_ip)
		for d in $COM_DOMAINS $COM_DL_DOMAINS; do pin "$d" "$target"; done
		cfg_bool override_cdn_hosts 1 && for d in $CDN_HOSTS; do pin "$d" "$target"; done
		srv_rules
		;;
	optimize)
		if ip=$(best_ip com) && best_domains com | grep -qw 'assets1.xboxlive.com'; then
			for d in $(best_domains com); do pin "$d" "$ip"; done
			cfg_bool override_cdn_hosts 1 && for d in $CDN_HOSTS; do pin "$d" "$ip"; done
			srv_rules
		fi
		;;
	esac
}

write_resolver_conf() {
	local new="$RESOLVER_CONF.new"
	mkdir -p "${RESOLVER_CONF%/*}" "$RUN_DIR" "$TMP_DIR"
	gen_resolver_conf >"$new"
	/usr/sbin/dnsmasq --test -C "$new" >/dev/null 2>&1 || { rm -f "$new"; die "生成的解析配置无效，保留旧配置"; }
	if cmp -s "$new" "$RESOLVER_CONF" 2>/dev/null; then
		rm -f "$new"
	else
		mv "$new" "$RESOLVER_CONF"
		: >"$RUN_DIR/cache_flush_needed"
	fi
}

# ---------- 主 dnsmasq 的固定规则 ----------

main_domains() {
	cfg_bool optimize_cn 1 && echo "$CN_DOMAINS"
	case "$(com_mode)" in
	off) ;;
	*)
		echo "$COM_DOMAINS $COM_DL_DOMAINS $SRV_NAMES"
		cfg_bool override_cdn_hosts 1 && echo "$CDN_HOSTS"
		;;
	esac
}

main_rules_now() {
	uci -q get "dhcp.$DNS_INSTANCE.server" | tr ' ' '\n' | grep .
}

# sync_main 1|0：同步规则；有变化时返回 0
sync_main() {
	local want=$1 port desired e changed=1 old now known
	local DNS_INSTANCE="$DNS_INSTANCE" previous_instance
	previous_instance=$(cat "$STATE_DIR/main_instance" 2>/dev/null)
	if [ "$want" = 0 ] && [ -n "$previous_instance" ]; then
		DNS_INSTANCE=$previous_instance
	elif [ -n "$previous_instance" ] && [ "$previous_instance" != "$DNS_INSTANCE" ]; then
		die "修改主 dnsmasq 实例前必须先停用插件，撤销旧实例规则"
	fi
	uci -q get "dhcp.$DNS_INSTANCE" >/dev/null || { note "找不到 dhcp.$DNS_INSTANCE，无法写入解析规则"; return 1; }
	port=$(cfg resolver_port 5335)
	desired=""
	[ "$want" = 1 ] && desired=$(main_domains | tr ' ' '\n' | grep . | sed "s|.*|/&/127.0.0.1#$port|" | uniq_keep_order)
	now=$(main_rules_now)
	# “本插件写入的规则”= 上次记录的规则，加上配置里现存的、域名在本插件名单内
	# 且指向本插件端口的规则（上次操作被中断时记录可能不完整）
	known=$(for e in $CN_DOMAINS $COM_DOMAINS $COM_DL_DOMAINS $SRV_NAMES $CDN_HOSTS; do echo "/$e/127.0.0.1#$port"; done)
	old=$({
		cat "$STATE_DIR/main_rules" 2>/dev/null
		for e in $now; do echo "$known" | grep -qxF "$e" && echo "$e"; done
	} | uniq_keep_order)

	# 删除本插件以前写入、现在不需要的规则（同一条可能被别的程序复制成多条）
	for e in $old; do
		echo "$desired" | grep -qxF "$e" && continue
		while main_rules_now | grep -qxF "$e"; do
			uci -q del_list "dhcp.$DNS_INSTANCE.server=$e" || break
			changed=0
		done
	done
	for e in $desired; do
		echo "$now" | grep -qxF "$e" && continue
		uci -q add_list "dhcp.$DNS_INSTANCE.server=$e"
		changed=0
	done
	mkdir -p "$STATE_DIR"
	# 302 模式返回内网地址，仅为明确接管的下载域名放行重绑定保护。
	# 记录本插件实际新增的条目，卸载时不删除用户原先的例外。
	local rd desired_rd="" owned_rd remaining_rd="" existing_rd
	owned_rd=$(cat "$STATE_DIR/rebind_domains" 2>/dev/null)
	if [ "$want" = 1 ] && [ "$(com_mode)" = redirect ]; then
		desired_rd="$COM_DOMAINS $COM_DL_DOMAINS"
		cfg_bool override_cdn_hosts 1 && desired_rd="$desired_rd $CDN_HOSTS"
	fi
	for rd in $owned_rd; do
		if echo " $desired_rd " | grep -qF " $rd "; then
			remaining_rd="$remaining_rd $rd"
		else
			uci -q del_list "dhcp.$DNS_INSTANCE.rebind_domain=$rd" && changed=0
		fi
	done
	existing_rd=$(uci -q get "dhcp.$DNS_INSTANCE.rebind_domain")
	for rd in $desired_rd; do
		echo " $existing_rd " | grep -qF " $rd " && continue
		uci -q add_list "dhcp.$DNS_INSTANCE.rebind_domain=$rd" || return 1
		remaining_rd="$remaining_rd $rd"
		changed=0
	done
	if [ -n "$remaining_rd" ]; then
		echo "$remaining_rd" | tr ' ' '\n' | grep . | uniq_keep_order >"$STATE_DIR/rebind_domains"
	else
		rm -f "$STATE_DIR/rebind_domains"
	fi
	if [ "$changed" = 0 ]; then
		uci -q commit dhcp
	fi
	if [ -n "$desired" ]; then
		echo "$desired" >"$STATE_DIR/main_rules"
		echo "$DNS_INSTANCE" >"$STATE_DIR/main_instance"
	else
		rm -f "$STATE_DIR/main_rules" "$STATE_DIR/main_instance"
	fi
	return $changed
}

# Passwall 默认会另起一个 dnsmasq 副本接管局域网 DNS，副本在 Passwall 启动时
# 复制主 dnsmasq 的按域名上游规则。列出这些副本的配置文件。
passwall_dnsmasq_confs() {
	local p c
	for p in /proc/[0-9]*; do
		[ -r "$p/cmdline" ] || continue
		c=$(tr '\0' ' ' <"$p/cmdline" 2>/dev/null)
		case "$c" in
		*dnsmasq*passwall*) echo "$c" | tr ' ' '\n' | grep -A1 -x -e '-C' | tail -n 1 ;;
		esac
	done | grep . | uniq_keep_order
}

# 副本缺少本插件的规则时返回 0
passwall_out_of_sync() {
	local conf e miss=1 desired
	desired=$(cat "$STATE_DIR/main_rules" 2>/dev/null)
	for conf in $(passwall_dnsmasq_confs); do
		[ -f "$conf" ] || continue
		for e in $desired; do
			grep -qxF "server=$e" "$conf" || miss=0
		done
		# 已停用时副本里不应残留指向本插件的规则
		for e in $(grep -E "^server=/.*/127\.0\.0\.1#$(cfg resolver_port 5335)\$" "$conf" | sed 's/^server=//'); do
			echo "$desired" | grep -qxF "$e" || miss=0
		done
	done
	return $miss
}

sync_passwall() {
	passwall_out_of_sync || return 0
	if cfg_bool passwall_restart 1 && [ -x /etc/init.d/passwall ]; then
		note "Passwall 的 DNS 副本需要重新载入解析规则，正在重启 Passwall"
		svc /etc/init.d/passwall restart
		# 重启后直连集合被重建，把当前节点加回去
		passwall_direct $(best_ip cn) $(best_ip com)
	else
		note "Passwall 的 DNS 副本还没有载入本插件的规则，请手动重启 Passwall"
	fi
}

# ---------- uhttpd 的 302 入口 ----------

sync_uhttpd() {
	local want=$1 cur
	uci -q get uhttpd.main >/dev/null || return 0
	cur=$(uci -q get uhttpd.main.error_page)
	if [ "$want" = 1 ]; then
		[ "$cur" = "$CGI_URL" ] && return 0
		mkdir -p "$STATE_DIR"
		[ -n "$cur" ] && echo "$cur" >"$STATE_DIR/uhttpd_error_page"
		uci -q set "uhttpd.main.error_page=$CGI_URL"
	else
		[ "$cur" = "$CGI_URL" ] || return 0
		if [ -s "$STATE_DIR/uhttpd_error_page" ]; then
			uci -q set "uhttpd.main.error_page=$(cat "$STATE_DIR/uhttpd_error_page")"
		else
			uci -q delete uhttpd.main.error_page
		fi
		rm -f "$STATE_DIR/uhttpd_error_page"
	fi
	uci -q commit uhttpd
	svc /etc/init.d/uhttpd restart
}

# ---------- 定时任务 ----------

sync_cron() {
	local want=$1 new="$TMP_DIR/cron.new" sched hi
	mkdir -p "$TMP_DIR" "${CRON_FILE%/*}"
	touch "$CRON_FILE"
	grep -vF "$CRON_TAG" "$CRON_FILE" >"$new"
	if [ "$want" = 1 ]; then
		sched=$(cfg cron "15 5 * * *")
		[ -n "$sched" ] && echo "$sched /usr/bin/xbox-accel start_test >/dev/null 2>&1 $CRON_TAG" >>"$new"
		hi=$(to_int "$(cfg health_interval 10)")
		[ "$hi" -gt 0 ] && [ "$hi" -lt 60 ] &&
			echo "*/$hi * * * * /usr/bin/xbox-accel health >/dev/null 2>&1 $CRON_TAG" >>"$new"
	fi
	if cmp -s "$new" "$CRON_FILE"; then
		rm -f "$new"
		return 0
	fi
	cat "$new" >"$CRON_FILE"
	rm -f "$new"
	svc /etc/init.d/cron enable
	svc /etc/init.d/cron restart
}

# ---------- 由 init 脚本调用 ----------

# 当前真正生效的分组：国内优选；国际域名处于优选模式时的国际优选
groups_active() {
	cfg_bool optimize_cn 1 && echo cn
	[ "$(com_mode)" = optimize ] && echo com
	return 0
}

setup() {
	local why
	validate_config
	apply_lock
	if cfg_bool redirect_cn 0; then
		why=$(redirect_blocker)
		[ -n "$why" ] && note "com→cn 重定向无法启用：$why；国际域名改按“国际 CDN 优选”的设置处理"
	fi
	write_resolver_conf
	if sync_main 1; then
		svc /etc/init.d/dnsmasq restart
	fi
	if [ "$(com_mode)" = redirect ]; then sync_uhttpd 1; else sync_uhttpd 0; fi
	sync_cron 1
	passwall_direct $(best_ip cn) $(best_ip com)
	com_mode >"$RUN_DIR/applied_mode"
	return 0
}

# 解析实例就绪后再检查 Passwall，避免它重启时规则指向一个还没起来的端口
post_start() {
	local g missing=1
	apply_lock
	sync_passwall
	if [ -f "$RUN_DIR/cache_flush_needed" ]; then
		flush_front_cache
		rm -f "$RUN_DIR/cache_flush_needed"
	fi
	# 启用后还没有测速结果时立即测一次，不必等到定时任务
	for g in $(groups_active); do
		best_ip "$g" >/dev/null || missing=0
	done
	if [ "$missing" = 0 ] && ! task_running; then
		(start_task all) >/dev/null 2>&1 7>&-
	fi
	return 0
}

teardown() {
	apply_lock
	cancel_task
	if sync_main 0; then
		svc /etc/init.d/dnsmasq restart
	fi
	sync_uhttpd 0
	sync_cron 0
	sync_passwall
	rm -f "$RESOLVER_CONF" "$RUN_DIR/applied_mode" "$RUN_DIR/cache_flush_needed"
	return 0
}

is_enabled() { cfg_bool enabled 0; }

apply() {
	if is_enabled; then
		"$INIT" reload 7>&- 8>&- 9>&-
	else
		say "服务未启用：结果已保存，启用后生效"
	fi
}

resolver_running() { process_matches "$(cat "$RUN_DIR/dnsmasq.pid" 2>/dev/null)" "$RESOLVER_CONF"; }

# SIGHUP 只重新读 hosts/resolv 并清空缓存，不重启 DNS/DHCP 服务。
# 只按实际进程名和完整配置路径匹配，绝不信任可能处于 PID namespace 的 PID 文件。
flush_front_cache() {
	local id f pid comm cmd conf match
	id=$(uci -q show "dhcp.$DNS_INSTANCE" | awk -F '[.=]' 'NR==1{print $2}')
	[ -n "$id" ] || return 0
	for f in /proc/[0-9]*/comm; do
		read -r comm <"$f" 2>/dev/null || continue
		[ "$comm" = dnsmasq ] || continue
		pid=${f#/proc/}; pid=${pid%/comm}
		cmd=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null)
		match=0
		printf '%s\n' "$cmd" | grep -qxF "/var/etc/dnsmasq.conf.$id" && match=1
		for conf in $(passwall_dnsmasq_confs); do
			printf '%s\n' "$cmd" | grep -qxF "$conf" && match=1
		done
		[ "$match" = 1 ] && kill -HUP "$pid" 2>/dev/null
	done
	return 0
}

# 已应用的状态与当前应有的状态不一致时返回 0：解析实例退出、主 dnsmasq 里的规则
# 被其他程序改掉、重定向的前置条件发生变化
drifted() {
	local e now
	resolver_running || return 0
	[ "$(cat "$RUN_DIR/applied_mode" 2>/dev/null)" = "$(com_mode)" ] || return 0
	now=$(main_rules_now)
	for e in $(cat "$STATE_DIR/main_rules" 2>/dev/null); do
		echo "$now" | grep -qxF "$e" || return 0
	done
	return 1
}

# ---------- 解析查询 ----------

# q_a 域名 服务器[:端口] → A 记录，空格分隔
q_a() {
	nslookup -type=a -timeout=1 -retry=1 "$1" "$2" 2>/dev/null |
		awk '/^Name:/{f=1} f && /^Address/{print $NF}' | ipv4s | tr '\n' ' ' | sed 's/ $//'
}

# 有 AAAA 记录时返回 0
has_aaaa() {
	nslookup -type=aaaa -timeout=1 -retry=1 "$1" "$2" 2>/dev/null |
		awk '/^Name:/{f=1} f && /^Address/{print $NF}' | grep -q ':'
}

# 该域名经本插件处理后应得到的地址；不处理时无输出
expected_ip() {
	case "$1" in
	cn) cfg_bool optimize_cn 1 && best_domains cn | grep -qw assets1.xboxlive.cn && best_ip cn ;;
	com)
		case "$(com_mode)" in
		redirect) lan_ip ;;
		optimize) best_domains com | grep -qw assets1.xboxlive.com && best_ip com ;;
		esac
		;;
	esac
}

# 局域网客户端的 DNS 请求被防火墙重定向到的端口（Passwall 等会这样做）
dns_redirect_ports() {
	{
		nft -t list ruleset 2>/dev/null | grep -E 'dport 53 ' | grep -oE 'redirect to :[0-9]+' | grep -oE '[0-9]+$'
		iptables-save -t nat 2>/dev/null | grep -E -- '--dport 53 ' | grep -oE -- '--to-ports [0-9]+' | grep -oE '[0-9]+$'
	} | uniq_keep_order
}

listeners_53() {
	netstat -lnup 2>/dev/null | awk '$4 ~ /:53$/ {sub(/^[0-9]*\//, "", $NF); print $NF}' | uniq_keep_order | tr '\n' ' ' | sed 's/ $//'
}

passwall_state() {
	if nft list table inet passwall >/dev/null 2>&1 || { command -v ipset >/dev/null 2>&1 && ipset list -n psw_white >/dev/null 2>&1; }; then
		echo running
	elif [ -x /etc/init.d/passwall ]; then
		echo stopped
	elif [ -x /etc/init.d/passwall2 ]; then
		echo passwall2
	else
		echo none
	fi
}

in_passwall_direct() {
	if nft list set inet passwall psw_white >/dev/null 2>&1; then
		nft get element inet passwall psw_white "{ $1 }" >/dev/null 2>&1
	else
		ipset test psw_white "$1" >/dev/null 2>&1
	fi
}

# ---------- LuCI / rpcd ----------

json_status() {
	. /usr/share/libubox/jshn.sh
	local g last
	json_init
	json_add_string version "$VERSION"
	if is_enabled; then json_add_boolean enabled 1; else json_add_boolean enabled 0; fi
	if resolver_running; then json_add_boolean running 1; else json_add_boolean running 0; fi
	if task_running; then json_add_boolean testing 1; else json_add_boolean testing 0; fi
	json_add_string mode "$(com_mode)"
	if cfg_bool optimize_cn 1; then json_add_boolean optimize_cn 1; else json_add_boolean optimize_cn 0; fi
	json_add_string lan_ip "$(lan_ip)"
	for g in cn com; do
		json_add_string "${g}_ip" "$(best_ip "$g")"
		last=$(cat "$TMP_DIR/last_$g" 2>/dev/null)
		set -- $last
		json_add_string "${g}_speed" "${2:+$(fmt_speed "$2")}"
		json_add_int "${g}_time" "$(to_int "$3")"
	done
	json_add_string log "$(tail -n 300 "$LOG_FILE" 2>/dev/null)"
	json_dump
}

env_row() { # 名称 级别（ok|info|warn|fail） 说明
	json_add_object ""
	json_add_string name "$1"
	json_add_string level "$2"
	json_add_string detail "$3"
	json_close_object
}

# 逐项检测运行环境。这里的检测都在路由器本机进行，无法代替在 Xbox 上的实际验证。
json_env() {
	. /usr/share/libubox/jshn.sh
	local enabled=0 port miss t v d lv g ip got ports p conf pw n want url code why mode
	is_enabled && enabled=1
	port=$(cfg resolver_port 5335)
	mode=$(com_mode)
	json_init
	json_add_array environment

	# 系统与依赖
	d=$(. /etc/openwrt_release 2>/dev/null && echo "$DISTRIB_DESCRIPTION，$DISTRIB_ARCH")
	if [ -x /sbin/fw4 ]; then d="$d，防火墙 fw4（nftables）"; else d="$d，防火墙 fw3（iptables）"; fi
	env_row "系统" info "${d:-未知}"
	env_row "路由器当前时间" info "$(date '+%Y-%m-%d %H:%M:%S %Z')；所有时间安排以此系统时区为准"
	miss=""
	for t in dnsmasq curl flock nslookup uci ubus netstat; do
		command -v "$t" >/dev/null 2>&1 || miss="$miss $t"
	done
	[ -f /usr/share/libubox/jshn.sh ] || miss="$miss jshn"
	if [ -n "$miss" ]; then
		env_row "依赖组件" fail "缺少：$miss"
	else
		env_row "依赖组件" ok "dnsmasq $(dnsmasq -v 2>/dev/null | awk 'NR==1{print $3}')，curl $(curl -V 2>/dev/null | awk 'NR==1{print $2}')"
	fi

	# 配置校验
	v=$( (validate_config) 2>&1)
	if [ -n "$v" ]; then
		env_row "配置" fail "${v#错误：}。修正前服务不会载入新配置"
	else
		env_row "配置" ok "参数有效"
	fi

	# 主 dnsmasq
	if [ "$(uci -q get "dhcp.$DNS_INSTANCE")" != dnsmasq ]; then
		env_row "主 dnsmasq" fail "配置里没有 dhcp.$DNS_INSTANCE"
	else
		v=$(listeners_53)
		case " $v " in
		*" dnsmasq "*)
			if [ "$v" = dnsmasq ]; then
				env_row "主 dnsmasq" ok "监听 53 端口的只有 dnsmasq"
			else
				env_row "主 dnsmasq" warn "53 端口上还有其他程序：$v。客户端请求不经过 dnsmasq 时本插件不生效"
			fi
			;;
		*) env_row "主 dnsmasq" fail "53 端口上没有 dnsmasq（当前：${v:-无}）。本插件依赖 dnsmasq 接收客户端的 DNS 请求" ;;
		esac
	fi

	# 普通查询的原有上游保持不变，方便核对 ChinaDNS 等分流链路。
	v=$(uci -q get "dhcp.$DNS_INSTANCE.server" | tr ' ' '\n' | grep -v '^/' | tr '\n' ' ')
	if [ -n "$v" ]; then
		env_row "主 DNS 原有上游" info "普通查询仍使用：$v（本插件仅新增下载域名规则）"
	else
		d=$(uci -q get "dhcp.$DNS_INSTANCE.resolvfile")
		env_row "主 DNS 原有上游" info "未配置全局 server；保留原 resolvfile / 其他分流设置：${d:-系统默认}"
	fi

	# 解析实例与规则
	if [ "$enabled" = 0 ]; then
		env_row "解析实例" info "插件未启用"
		if port_available "$port"; then lv=ok d="端口 $port 空闲"; else lv=fail d="端口 $port 已被其他程序占用，请换一个端口"; fi
		env_row "解析端口" "$lv" "$d"
	else
		if resolver_running; then
			env_row "解析实例" ok "运行中，127.0.0.1:$port"
		else
			env_row "解析实例" fail "未运行。被接管的下载域名此时无法解析，请查看系统日志"
		fi
		n=0 miss=0 got=$(main_rules_now)
		for t in $(cat "$STATE_DIR/main_rules" 2>/dev/null); do
			n=$((n + 1))
			echo "$got" | grep -qxF "$t" || miss=$((miss + 1))
		done
		if [ "$n" = 0 ]; then
			env_row "主 dnsmasq 规则" fail "没有写入任何规则"
		elif [ "$miss" -gt 0 ]; then
			env_row "主 dnsmasq 规则" fail "应有 $n 条，缺少 $miss 条（可能被其他程序改写），点“重新应用”恢复"
		else
			env_row "主 dnsmasq 规则" ok "$n 条下载域名规则指向 127.0.0.1#$port"
		fi
	fi

	# 客户端的 DNS 请求实际到达哪里
	ports=$(dns_redirect_ports | grep -vx 53 | head -n 3 | tr '\n' ' ')
	pw=$(passwall_state)
	if [ -z "$ports" ]; then
		env_row "DNS 入口" ok "没有发现 DNS 重定向规则，客户端发给路由器的请求直接到主 dnsmasq"
	else
		for p in $ports; do
			conf=""
			for t in $(passwall_dnsmasq_confs); do
				grep -qx "port=$p" "$t" 2>/dev/null && conf=$t
			done
			if [ -z "$conf" ]; then
				env_row "DNS 入口" warn "防火墙把局域网 DNS 请求重定向到端口 $p，那里不是已识别的 dnsmasq，本插件的规则可能不生效"
			elif [ "$enabled" = 1 ] && passwall_out_of_sync; then
				env_row "DNS 入口" fail "请求被重定向到 Passwall 的 dnsmasq 副本（端口 $p），副本还没有载入本插件的规则，需要重启 Passwall"
			else
				env_row "DNS 入口" ok "请求被重定向到 Passwall 的 dnsmasq 副本（端口 $p），副本会复制主 dnsmasq 的下载域名规则"
			fi
		done
	fi

	# 实际解析结果：主 dnsmasq 和每个重定向入口都查一遍
	if [ "$enabled" = 1 ]; then
		for g in cn com; do
			d="assets1.xboxlive.$g"
			want=$(expected_ip "$g")
			if [ -z "$want" ]; then
				if [ "$g" = cn ] && ! cfg_bool optimize_cn 1; then
					env_row "解析 $d" info "国内优选未开启，按默认解析"
				elif [ "$g" = com ] && [ "$mode" = off ]; then
					env_row "解析 $d" info "国际域名不处理，按默认解析"
				else
					env_row "解析 $d" info "还没有测速结果，暂按默认解析"
				fi
				continue
			fi
			lv=ok v=""
			for p in 53 $ports; do
				got=$(q_a "$d" "127.0.0.1:$p")
				if [ "$got" = "$want" ]; then
					v="$v 端口 $p → $got；"
				else
					lv=fail
					v="$v 端口 $p → ${got:-无结果}（应为 $want）；"
				fi
				has_aaaa "$d" "127.0.0.1:$p" && { lv=fail; v="$v 端口 $p 仍返回 IPv6 地址；"; }
			done
			env_row "解析 $d" "$lv" "$v"
		done
	fi

	# com→cn 重定向
	if cfg_bool redirect_cn 0; then
		why=$(redirect_blocker)
		if [ -n "$why" ]; then
			env_row "com→cn 重定向" fail "无法启用：$why"
		elif [ "$enabled" = 1 ]; then
			got=$(curl -s --noproxy '*' -o /dev/null -m 4 -H 'Host: assets1.xboxlive.com' \
				-w '%{http_code} %{redirect_url}' "http://$(lan_ip)/xbox-accel/selftest?probe=1" 2>/dev/null)
			if [ "$got" = "302 http://assets1.xboxlive.cn/xbox-accel/selftest?probe=1" ]; then
				env_row "com→cn 重定向" ok "http://$(lan_ip) 对国际下载域名返回 302，路径与参数保持不变"
			else
				env_row "com→cn 重定向" fail "自检请求得到“${got:-无响应}”，应为 302 到 assets1.xboxlive.cn"
			fi
		else
			env_row "com→cn 重定向" ok "前置条件满足：uhttpd 在 80 端口提供 HTTP"
		fi
	else
		env_row "com→cn 重定向" info "未开启"
	fi

	# 测速文件
	for g in $(groups_enabled); do
		url=$(group_url "$g")
		ip=$(q_a "$(url_host "$url")" "$(cfg fallback_dns 223.5.5.5 | awk '{print $1}')" | awk '{print $1}')
		if [ -z "$ip" ]; then
			env_row "测速文件（$g）" warn "无法通过 $(cfg fallback_dns 223.5.5.5 | awk '{print $1}') 解析 $(url_host "$url")，外网或上游 DNS 不通时自动测速会失败"
			continue
		fi
		code=$(probe "$ip" "$(url_host "$url")" "$(url_path "$url")" "$(group_offset "$g")" 1024 6 | awk '{print $1}')
		if [ "$code" = 206 ]; then
			env_row "测速文件（$g）" ok "可下载：$url"
		else
			env_row "测速文件（$g）" warn "节点 $ip 返回 HTTP ${code:-000}。持续如此说明该文件已失效，需要更换测速地址"
		fi
	done

	# 定时任务
	if [ "$enabled" = 1 ]; then
		n=$(grep -cF "$CRON_TAG" "$CRON_FILE" 2>/dev/null)
		if [ "$(to_int "$n")" = 0 ]; then
			env_row "定时任务" fail "计划任务里没有本插件的条目，点“重新应用”恢复"
		elif ! pidof crond >/dev/null 2>&1; then
			env_row "定时任务" fail "cron 服务没有运行，自动测速和健康检查不会执行"
		else
			env_row "定时任务" ok "完整测速：$(schedule_label)；健康检查：$(health_label)；使用路由器系统时区"
		fi
	fi

	# Passwall
	case "$pw" in
	none) env_row "Passwall" info "未检测到 Passwall" ;;
	passwall2) env_row "Passwall" warn "检测到 Passwall 2：本插件没有适配它的直连集合和 DNS 副本，请在 Passwall 2 里把 Xbox 下载域名设为直连" ;;
	stopped) env_row "Passwall" info "已安装，当前没有运行" ;;
	running)
		if ! cfg_bool passwall_direct 1; then
			env_row "Passwall" warn "运行中；“加入直连集合”已关闭，国际节点的下载流量可能被送进代理"
		else
			miss=""
			for ip in $(best_ip cn) $(best_ip com); do
				in_passwall_direct "$ip" || miss="$miss $ip"
			done
			if [ -n "$miss" ]; then
				env_row "Passwall" warn "运行中；当前节点$miss 不在直连集合 psw_white 里（健康检查会重新加入；Passwall 关闭了“直连列表”时该集合不起作用）"
			else
				env_row "Passwall" ok "运行中；当前节点已在直连集合 psw_white 里"
			fi
		fi
		;;
	esac

	json_close_array
	json_dump
}

# ---------- 命令 ----------

cmd_test() {
	local g only=$1 any=1
	validate_config
	command -v curl >/dev/null 2>&1 || die "缺少 curl"
	lock
	say "开始测速"
	for g in $(groups_enabled); do
		[ -n "$only" ] && [ "$only" != all ] && [ "$only" != "$g" ] && continue
		test_group "$g" && any=0
	done
	if [ "$any" = 0 ]; then
		apply
		say "测速结束"
	else
		note "测速没有得到可用节点，现有配置保持不变"
	fi
	return "$any"
}

cmd_health() {
	local g ip url changed=1 try ok now last
	is_enabled || return 0
	lock
	if drifted; then
		note "解析实例或主 dnsmasq 规则与应有状态不一致，重新应用"
		changed=0
	fi
	for g in $(groups_active); do
		if ! ip=$(best_ip "$g"); then
			# 还没有可用节点：最多每 30 分钟重试一次
			now=$(date +%s)
			last=$(to_int "$(cat "$TMP_DIR/retry_$g" 2>/dev/null)")
			[ $((now - last)) -ge 1800 ] || continue
			echo "$now" >"$TMP_DIR/retry_$g"
			note "[$g] 还没有可用节点，尝试测速"
			test_group "$g" && changed=0
			continue
		fi
		passwall_direct "$ip"
		url=$(group_url "$g")
		ok=1
		for try in 1 2 3; do
			if alive "$ip" "$(url_host "$url")" "$(url_path "$url")" "$(group_offset "$g")"; then
				ok=0
				break
			fi
			sleep 3
		done
		[ "$ok" = 0 ] && continue
		note "[$g] 当前节点 $ip 连续 3 次不可用，重新测速"
		# 全部候选都不可用时 test_group 会保留现有配置（多半是外网中断）
		test_group "$g" && changed=0
	done
	[ "$changed" = 0 ] && apply
	return 0
}


cmd_status() {
	local g ip last port pid
	port=$(cfg resolver_port 5335)
	say "xbox-accel $VERSION"
	if is_enabled; then say "服务：已启用"; else say "服务：未启用"; fi
	pid=$(cat "$RUN_DIR/dnsmasq.pid" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		say "解析实例：运行中（127.0.0.1:$port，PID $pid）"
	else
		say "解析实例：未运行"
	fi
	cfg_bool optimize_cn 1 && say "国内域名：优选" || say "国内域名：不处理"
	case "$(com_mode)" in
	redirect) say "国际域名：重定向到国内（302 入口 $(lan_ip)）" ;;
	optimize) say "国际域名：优选" ;;
	off) say "国际域名：不处理" ;;
	esac
	cfg_bool redirect_cn 0 && [ -n "$(redirect_blocker)" ] && say "  重定向未生效：$(redirect_blocker)"
	for g in cn com; do
		ip=$(best_ip "$g") || { say "[$g] 还没有测速结果"; continue; }
		last=$(cat "$TMP_DIR/last_$g" 2>/dev/null)
		if [ -n "$last" ]; then
			set -- $last
			say "[$g] 节点 $ip，$(fmt_speed "$2")，测于 $(date -d "@$3" '+%m-%d %H:%M' 2>/dev/null || echo "$3")"
		else
			say "[$g] 节点 $ip（重启后尚未复测）"
		fi
		say "      已固定域名：$(best_domains "$g")"
	done
	say "主 dnsmasq 规则：$(cat "$STATE_DIR/main_rules" 2>/dev/null | grep -c .) 条"
	if is_enabled; then
		say "经主 dnsmasq 查询："
		say "  assets1.xboxlive.cn  → $(q_a assets1.xboxlive.cn 127.0.0.1)"
		say "  assets1.xboxlive.com → $(q_a assets1.xboxlive.com 127.0.0.1)"
	fi
}

cmd_check() {
	local out keys k name level detail mark
	out=$(json_env)
	. /usr/share/libubox/jshn.sh
	json_load "$out" || die "环境检测失败"
	json_select environment
	json_get_keys keys
	for k in $keys; do
		json_select "$k"
		json_get_var name name
		json_get_var level level
		json_get_var detail detail
		json_select ..
		case "$level" in
		ok) mark="[ 正常 ]" ;;
		warn) mark="[ 注意 ]" ;;
		fail) mark="[ 异常 ]" ;;
		*) mark="[ 信息 ]" ;;
		esac
		say "$mark $name：$detail"
	done
	say
	say "以上检测都在路由器本机进行。最终请在局域网设备上确认：nslookup assets1.xboxlive.cn $(lan_ip)"
}

cmd_enable() {
	uci -q set "$NAME.main.enabled=1" && uci -q commit "$NAME" || die "无法写入配置"
	"$INIT" enable
	"$INIT" restart
	cmd_status
}

cmd_disable() {
	uci -q set "$NAME.main.enabled=0" && uci -q commit "$NAME" || die "无法写入配置"
	"$INIT" stop
	say "已停用：主 dnsmasq 规则、302 入口和定时任务均已移除"
}

cmd_reset() {
	rm -f "$STATE_DIR"/best_* "$STATE_DIR"/domains_* "$TMP_DIR"/last_*
	say "已清除测速结果"
	apply
}

usage() {
	cat <<EOF
xbox-accel $VERSION

用法：xbox-accel <命令>
  test [cn|com]  发现候选节点、测速、选优并应用（在当前终端里运行）
  start_test     同上，但作为后台任务运行（定时任务和 LuCI 用的就是它）
  cancel         停止正在运行的后台任务
  status         查看当前模式、节点和解析结果
  check          环境检测：DNS 链路、解析结果、重定向、定时任务、Passwall
  enable         启用并设为开机自启
  disable        停用并撤销对系统的全部改动
  health         检查当前节点是否可用，不可用则重新测速
  reset          清除测速结果，恢复默认解析
EOF
}

case "$1" in
test) cmd_test "$2" ;;
health) cmd_health ;;
status) cmd_status ;;
check) cmd_check ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
reset) cmd_reset ;;
cancel) cancel_task ;;
start_test)
	validate_config
	start_task "${2:-all}"
	;;
clear_log)
	mkdir -p "$TMP_DIR"
	: >"$LOG_FILE"
	;;
json_status) json_status ;;
json_env) json_env ;;
_worker)
	mkdir -p "$TMP_DIR"
	QUIET=1
	exec >>"$LOG_FILE" 2>&1
	cmd_test "$2"
	;;
_validate) validate_config ;;
_setup) setup ;;
_post_start) post_start ;;
_teardown) teardown ;;
-v | --version) echo "$VERSION" ;;
*) usage ;;
esac
