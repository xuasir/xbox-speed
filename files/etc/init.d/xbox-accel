#!/bin/sh
# xbox-accel: Xbox 下载 CDN 优选 + com→cn 重定向

# 直接调用时先进入有期限的控制层；rc.common 加载本文件时仅注册服务钩子。
if [ -z "${initscript:-}" ]; then
	[ "$#" -gt 0 ] || set -- help
	exec /usr/bin/xbox-accel _service "$@"
fi

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/xbox-accel
CONF=/var/etc/xbox-accel/dnsmasq.conf

restart() {
	stop "$@" || return $?
	start "$@"
}

# Keep the init hook registered even when autostart is off: persisted DNS
# rules from the previous session must be withdrawn before clients use them.
boot() {
	local autostart
	config_load xbox-accel
	config_get_bool autostart main autostart 1
	if [ "$autostart" != 1 ]; then
		"$PROG" _teardown
		return $?
	fi
	start
}

start_service() {
	local enabled
	config_load xbox-accel
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		"$PROG" _teardown
		return $?
	fi

	"$PROG" _setup || return 1
	[ -s "$CONF" ] || return 1

	procd_open_instance resolver
	procd_set_param command /usr/sbin/dnsmasq -k -C "$CONF"
	# 配置文件内容变化时，reload 会让 procd 重启这个实例
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	local enabled
	config_load xbox-accel
	config_get_bool enabled main enabled 0
	if [ "$enabled" = 1 ]; then
		"$PROG" _post_start || return 1
	fi
	return 0
}

stop_service() {
	"$PROG" _teardown
	XBOX_STOP_RESULT=$?
	return "$XBOX_STOP_RESULT"
}

service_stopped() {
	local result=${XBOX_STOP_RESULT:-0}
	"$PROG" _stop_resolver || result=1
	return "$result"
}

reload_service() {
	if [ "$(uci -q get xbox-accel.main.enabled)" = 1 ]; then
		"$PROG" _validate || return 1
	fi
	start
}

service_triggers() {
	procd_add_reload_trigger xbox-accel
}
