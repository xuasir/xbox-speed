#!/bin/sh
# xbox-accel: Xbox 下载 CDN 优选 + com→cn 重定向

# 直接调用时先进入有期限的控制层；rc.common 加载本文件时仅注册服务钩子。
if [ -z "${initscript:-}" ]; then
	[ "$#" -gt 0 ] || set -- help
	exec /usr/bin/xbox-accel _service "$@"
fi

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/xbox-accel
CONF=/var/etc/xbox-accel/dnsmasq.conf
REDIRECT_ROOT=/var/etc/xbox-accel/redirect
REDIRECT_CONF=/var/etc/xbox-accel/redirect.conf
REDIRECT_HTTPD_CONF=/var/etc/xbox-accel/redirect.httpd.conf

restart() {
	stop "$@" || return $?
	start "$@"
}

# Keep the init hook registered even when autostart is off: persisted DNS
# rules from the previous session must be withdrawn before clients use them.
boot() {
	local autostart
	config_load xbox-accel
	config_get_bool autostart main autostart 1
	if [ "$autostart" != 1 ]; then
		"$PROG" _teardown
		return $?
	fi
	start
}

start_service() {
	local enabled redirect_ip redirect_port redirect_entry redirect_device redirect_backend
	XBOX_START_RESULT=0
	config_load xbox-accel
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		"$PROG" _teardown
		XBOX_START_RESULT=$?
		return "$XBOX_START_RESULT"
	fi

	"$PROG" _setup
	XBOX_START_RESULT=$?
	[ "$XBOX_START_RESULT" = 0 ] || return "$XBOX_START_RESULT"
	[ -s "$CONF" ] || { XBOX_START_RESULT=1; return 1; }

	procd_open_instance resolver
	procd_set_param command /usr/sbin/dnsmasq -k -C "$CONF"
	# 配置文件内容变化时，reload 会让 procd 重启这个实例
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance observation
	procd_set_param command "$PROG" _observe
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	if [ -s "$REDIRECT_CONF" ]; then
		read -r redirect_ip redirect_port redirect_entry redirect_device redirect_backend <"$REDIRECT_CONF"
		procd_open_instance redirect
		procd_set_param command /usr/sbin/uhttpd -f -h "$REDIRECT_ROOT" -c "$REDIRECT_HTTPD_CONF" \
			-x / -E /redirect.cgi -I redirect.cgi -D -S -n 8 -N 32 -t 5 -T 10 -k 0 \
			-p "127.0.0.1:$redirect_port" -p "$redirect_ip:$redirect_port"
		procd_set_param file "$REDIRECT_CONF" "$REDIRECT_ROOT/redirect.cgi"
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_started() {
	local enabled
	[ "${XBOX_START_RESULT:-0}" = 0 ] || return "$XBOX_START_RESULT"
	config_load xbox-accel
	config_get_bool enabled main enabled 0
	if [ "$enabled" = 1 ]; then
		"$PROG" _post_start || return 1
	fi
	return 0
}

stop_service() {
	"$PROG" _teardown
	XBOX_STOP_RESULT=$?
	return "$XBOX_STOP_RESULT"
}

service_stopped() {
	local result=${XBOX_STOP_RESULT:-0}
	"$PROG" _stop_resolver || result=1
	"$PROG" _stop_redirect || result=1
	return "$result"
}

reload_service() {
	if [ "$(uci -q get xbox-accel.main.enabled)" = 1 ]; then
		"$PROG" _validate || return 1
	fi
	start
}

service_triggers() {
	procd_add_reload_trigger xbox-accel
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/xbox-accel reload
}
